---
// Copy mirrors the site canvas (row "Páginas de busca"); change both together.
import SolutionLayout from '../layouts/SolutionLayout.astro';
import OperacaoPanel from '../components/visuals/OperacaoPanel.astro';

const problem = {
  title: 'O problema não é a cozinha. É a saída.',
  paragraphs: [
    'Em horário de pico, alguém no restaurante vira despachante: decide quem leva cada pedido, manda o endereço no grupo do WhatsApp, explica o caminho, junta duas entregas “que ficam perto” e ainda responde o cliente perguntando “cadê meu pedido?”. Quando essa pessoa erra ou se atrasa, a comida esfria no balcão.',
    'O Tregou faz esse trabalho sozinho. Você continua com os seus entregadores, do seu jeito, mas quem distribui os pedidos é o sistema.',
  ],
};

const steps = {
  title: 'Como funciona',
  items: [
    {
      title: 'O pedido entra',
      text: 'Do iFood, sozinho. WhatsApp, telefone e balcão você lança em segundos, com o endereço no mapa. Endereço confuso? O painel já tem a mensagem pronta para pedir a localização ao cliente.',
    },
    {
      title: 'Vai para o entregador certo',
      text: 'Quem está esperando há mais tempo recebe primeiro. O celular dele toca, ele aceita ou recusa. Pedidos do mesmo caminho saem juntos, na ordem de entrega.',
    },
    {
      title: 'Chega na porta',
      text: 'Rota pronta no app, com o mapa e o prazo de cada entrega à vista. Você acompanha todos no painel, ao vivo, sem ligar para ninguém.',
    },
  ],
};

const list = {
  title: 'O que muda no dia a dia',
  items: [
    { title: 'Sem grupo de WhatsApp para despachar', text: 'Cada pedido vai para uma pessoa, com endereço e rota.' },
    { title: 'Fila justa entre os entregadores', text: 'Ninguém fica escolhendo as melhores corridas.' },
    { title: 'Menos viagens', text: 'Pedidos do mesmo caminho saem juntos.' },
    { title: 'Você sabe onde está cada pedido', text: 'Quem pegou, quem saiu, o que já foi entregue.' },
    { title: 'Relatório por entregador', text: 'Entregas feitas, dia a dia, para fechar o acerto sem planilha.' },
  ],
};

const who = {
  title: 'Para quem é',
  text: 'Para restaurantes, pizzarias, hamburguerias e lanchonetes que já têm entregadores próprios, fixos ou por diária. Tem poucos entregadores? Funciona igual. Ainda não tem? A Rede Tregou está começando em João Pessoa.',
};

const faqs = [
  {
    q: 'Preciso ter iFood para usar o Tregou?',
    a: 'Não. Os pedidos do iFood entram sozinhos, mas pedidos do WhatsApp, do telefone e do balcão você lança no painel em segundos. Muitos restaurantes usam só assim.',
  },
  {
    q: 'Meus entregadores precisam de quê?',
    a: 'Um celular Android com o app do Tregou. Você manda o link de instalação e eles entram com o número de telefone. Não precisa de e-mail nem de documento.',
  },
  {
    q: 'O Tregou junta pedidos na mesma saída?',
    a: 'Sim. Quando dois pedidos vão para o mesmo lado, eles saem com o mesmo entregador, na ordem certa. Você define quantos pedidos cada entregador leva por vez.',
  },
  {
    q: 'Consigo acompanhar os entregadores?',
    a: 'Sim. No painel você vê cada entregador no mapa, ao vivo, e o andamento de cada entrega: quem pegou, quem saiu, o que já foi entregue.',
  },
  {
    q: 'Quanto custa?',
    a: 'Você começa testando grátis, sem cartão. Depois escolhe o plano que cabe na sua operação.',
  },
];
---

<SolutionLayout
  slug="rest"
  title="Sistema de entregas para restaurantes com entregadores próprios | Tregou"
  description="Distribua os pedidos do seu restaurante entre seus entregadores sem grupo de WhatsApp: rota pronta no app, entregas juntadas no mesmo caminho e tudo no mapa, ao vivo."
  kicker="Para restaurantes"
  h1="Sistema de entregas para restaurantes com entregadores próprios"
  lede="Os pedidos do iFood, do WhatsApp e do balcão vão sozinhos para o entregador certo, na melhor rota. Você para de despachar e volta para a cozinha."
  problem={problem}
  steps={steps}
  list={list}
  who={who}
  faqs={faqs}
  closing="Veja o Tregou com os pedidos do seu restaurante."
  waText="Oi! Tenho um restaurante e quero saber como o Tregou funciona com meus entregadores."
>
  <OperacaoPanel slot="visual" />
</SolutionLayout>
