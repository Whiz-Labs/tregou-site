---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

// Courier side of the Rede Tregou (step 0: pre-registration before the network
// exists in the app). Five taps, then the pre-registration finishes on Tregou's
// WhatsApp with the answers already typed — a real person has to send it, which
// is the check that this is a courier and not a bot.
//
// Built for a courier's phone first: full screen, the one button always at the
// thumb, dark text that survives sunlight. Answers go to courier_leads
// (migrations 077, 078), insert-only via the anon key.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

// Where the pilot starts. The count of couriers per neighbourhood is what we
// show restaurants, so this list is the pilot area — edit it with the area.
const AREAS = [
  'Manaíra', 'Tambaú', 'Cabo Branco', 'Bessa', 'Miramar', 'Torre',
  'Estados', 'Centro', 'Bancários', 'Mangabeira', 'Altiplano', 'Cristo',
];
---

<BaseLayout
  title="Rede de entregadores Tregou"
  description="Entregas de restaurantes perto de você. Você escolhe quais pegar, e o valor da entrega é todo seu."
>
  <main class="quiz">
    <div class="card" data-intro="true">
      <div class="topbar">
        <button class="back" id="back" hidden aria-label="Voltar">←</button>
        <div class="bar" aria-hidden="true"><div class="bar-fill" id="bar"></div></div>
        <span class="count" id="count" aria-live="polite"></span>
      </div>

      <!-- 0 · INTRO -->
      <section class="step is-active" data-step="0">
        <div class="body">
          <div class="brand">
            <img src="/brand/tregou-wordmark-light.svg" alt="Tregou" height="30" />
          </div>
          <span class="chip">Rede de entregadores</span>
          <h1>Entregas perto de você, e o valor é <span class="hl">todo seu</span></h1>
          <p class="lead">Restaurantes do seu bairro chamam. Você escolhe quais pegar.</p>
          <ul class="trust">
            <li><span class="tk">✓</span>Sem documentos agora</li>
            <li><span class="tk">✓</span>5 toques, 30 segundos</li>
            <li><span class="tk">✓</span>Sem compromisso</li>
          </ul>
        </div>
        <div class="actions">
          <button class="btn btn-primary" data-ev="courier_quiz_start" data-next>Começar <span class="ar">→</span></button>
          <a class="skip" id="skip-wa" data-ev="courier_quiz_skip" href="#" target="_blank" rel="noopener noreferrer">Já quero entrar — falar no WhatsApp</a>
        </div>
      </section>

      <!-- 1 · how they work today (multi) -->
      <section class="step" data-step="1">
        <div class="body">
          <h2>Como você trabalha hoje?</h2>
          <p class="multi-hint">Pode marcar mais de um.</p>
          <div class="options">
            <button class="opt opt-check" data-q="work" data-val="apps">iFood / outros apps</button>
            <button class="opt opt-check" data-q="work" data-val="empresa">Empresa de motoboy</button>
            <button class="opt opt-check" data-q="work" data-val="restaurante">Direto com restaurante</button>
            <button class="opt opt-check" data-q="work" data-val="parado">Não estou entregando agora</button>
          </div>
        </div>
        <div class="actions"><button class="btn btn-primary continue" data-continue disabled>Continuar</button></div>
      </section>

      <!-- 2 · pains (multi) -->
      <section class="step" data-step="2">
        <div class="body">
          <h2>O que mais te incomoda hoje?</h2>
          <p class="multi-hint">Pode marcar mais de um.</p>
          <div class="options">
            <button class="opt opt-check" data-q="pain" data-val="parte">A empresa fica com parte do valor</button>
            <button class="opt opt-check" data-q="pain" data-val="taxa">Taxa baixa por entrega</button>
            <button class="opt opt-check" data-q="pain" data-val="punicao">Punição quando recuso</button>
            <button class="opt opt-check" data-q="pain" data-val="parado">Muito tempo parado esperando</button>
            <button class="opt opt-check" data-q="pain" data-val="atraso">Pagamento atrasado</button>
            <button class="opt opt-check" data-q="pain" data-val="escolha">Não escolho as entregas</button>
          </div>
        </div>
        <div class="actions"><button class="btn btn-primary continue" data-continue disabled>Continuar</button></div>
      </section>

      <!-- 3 · hours (multi) -->
      <section class="step" data-step="3">
        <div class="body">
          <h2>Quando você fica livre?</h2>
          <p class="multi-hint">Pode marcar mais de um.</p>
          <div class="options grid-2">
            <button class="opt opt-check" data-q="hours" data-val="almoco">Almoço</button>
            <button class="opt opt-check" data-q="hours" data-val="tarde">Tarde</button>
            <button class="opt opt-check" data-q="hours" data-val="jantar">Jantar</button>
            <button class="opt opt-check" data-q="hours" data-val="noite">Noite</button>
            <button class="opt opt-check" data-q="hours" data-val="fds">Fim de semana</button>
          </div>
        </div>
        <div class="actions"><button class="btn btn-primary continue" data-continue disabled>Continuar</button></div>
      </section>

      <!-- 4 · neighbourhoods (multi) -->
      <section class="step" data-step="4">
        <div class="body">
          <h2>Em quais bairros você roda?</h2>
          <p class="multi-hint">Pode marcar mais de um.</p>
          <div class="options grid-2">
            {AREAS.map((a) => (
              <button class="opt opt-check opt-sm" data-q="areas" data-val={a}>{a}</button>
            ))}
            <button class="opt opt-check opt-sm" data-q="areas" data-val="Outro">Outro</button>
          </div>
        </div>
        <div class="actions"><button class="btn btn-primary continue" data-continue disabled>Continuar</button></div>
      </section>

      <!-- 5 · vehicle (single, auto-advance) -->
      <section class="step" data-step="5">
        <div class="body">
          <h2>Tem moto própria e CNH categoria A?</h2>
          <div class="options">
            <button class="opt" data-q="vehicle" data-val="ambos">Tenho as duas</button>
            <button class="opt" data-q="vehicle" data-val="moto">Só a moto</button>
            <button class="opt" data-q="vehicle" data-val="cnh">Só a CNH</button>
            <button class="opt" data-q="vehicle" data-val="nenhum">Nenhuma das duas</button>
          </div>
        </div>
      </section>

      <!-- 6 · RESULT -->
      <section class="step" data-step="6">
        <div class="body">
          <div class="badge">Feito pra você</div>
          <h2>A Rede Tregou foi feita pra isso</h2>
          <p class="result-intro" id="result-intro"></p>
          <div class="outcomes">
            <div class="oc"><span class="ck">✓</span><span>Você escolhe quais entregas pegar. Sem punição.</span></div>
            <div class="oc"><span class="ck">✓</span><span>O valor da entrega é todo seu.</span></div>
            <div class="oc"><span class="ck">✓</span><span>O restaurante paga direto no seu Pix, no mesmo dia.</span></div>
            <div class="oc" data-when="escolha" hidden><span class="ck">✓</span><span>Você vê o valor e a distância antes de aceitar.</span></div>
            <div class="oc" data-when="parado" hidden><span class="ck">✓</span><span>Ofertas de restaurantes perto de você.</span></div>
          </div>
          <p class="note">Começamos pelos bairros onde já temos restaurantes.</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary btn-wa" id="go-wa" href="#" target="_blank" rel="noopener noreferrer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.7.7 2.3.8 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Fazer meu pré-cadastro
          </a>
          <p class="cta-note">Abre o WhatsApp com suas respostas. É só enviar.</p>
        </div>
      </section>

      <!-- 7 · DONE + bring others -->
      <section class="step" data-step="7">
        <div class="body">
          <div class="badge">Quase lá</div>
          <h2>Enviou a mensagem? Pronto.</h2>
          <p class="lead">A gente te responde no WhatsApp e avisa quando as ofertas começarem no seu bairro.</p>
          <a class="again" id="again-wa" href="#" target="_blank" rel="noopener noreferrer">Não enviou? Abrir o WhatsApp de novo</a>

          <div class="invite">
            <h3>Chame outros entregadores</h3>
            <p>Mais entregadores no seu bairro trazem mais restaurantes pra lá. Mande seu link:</p>
            <div class="link-box">
              <span>Seu código: <b id="my-code"></b></span>
              <button class="copy" id="copy-link" type="button">Copiar</button>
            </div>
          </div>
        </div>
        <div class="actions">
          <a class="btn btn-primary btn-wa" id="share-link" data-ev="courier_share" href="#" target="_blank" rel="noopener noreferrer">Enviar meu link no WhatsApp</a>
        </div>
      </section>
    </div>
  </main>

  <style>
    .quiz {
      --g: #2b9348; --g-deep: #1b6e36; --g-tint: #e4f1e7; --amber: #f9c74f;
      --ink: #111a15; --muted: #3f4b44; --line: #d9e2d5;
      --bg: #f5f8f3; --surface: #ffffff; --wa: #1faa55;
      min-height: 100dvh; display: grid; place-items: safe center;
      /* An auto track grows to its widest line; pin it to the screen. */
      grid-template-columns: minmax(0, 1fr);
      background:
        radial-gradient(90% 60% at 85% -10%, rgba(43, 147, 72, 0.13), transparent 70%),
        radial-gradient(70% 50% at 0% 110%, rgba(249, 199, 79, 0.10), transparent 70%),
        var(--bg);
      padding: clamp(14px, 4vw, 28px); color: var(--ink);
    }
    .card {
      width: 100%; max-width: 512px; background: var(--surface);
      border: 1px solid var(--line); border-radius: 20px;
      padding: clamp(22px, 4vw, 36px); position: relative;
      box-shadow: 0 1px 2px rgba(20, 60, 35, 0.05), 0 24px 60px -30px rgba(20, 60, 35, 0.42);
      display: flex; flex-direction: column;
    }

    /* On a phone the card is the screen: no frame, no margin, the page scrolls
       under a button that stays at the thumb. */
    @media (max-width: 559px) {
      .quiz { padding: 0; place-items: stretch; background: var(--surface); }
      .card { border: 0; border-radius: 0; box-shadow: none; min-height: 100dvh; padding: 16px 20px 0; }
    }

    .topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; min-height: 44px; }
    .card[data-intro="true"] .topbar { display: none; }
    .bar { flex: 1; height: 6px; background: var(--g-tint); border-radius: 100px; overflow: hidden; }
    .bar-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--g), var(--g-deep)); border-radius: 100px; transition: width .4s ease; }
    .count { font-size: 0.85rem; font-weight: 700; color: var(--g-deep); min-width: 30px; text-align: right; }
    .back { flex: 0 0 auto; width: 44px; height: 44px; margin-left: -10px; padding: 0; background: none; border: none; color: var(--ink); font: inherit; font-size: 1.4rem; cursor: pointer; border-radius: 12px; }
    .back:hover { background: var(--g-tint); }
    .back[hidden] { visibility: hidden; display: block; }

    .step { display: none; flex-direction: column; flex: 1; }
    .step.is-active { display: flex; animation: fade .3s ease; }
    @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .step.is-active { animation: none; } .bar-fill { transition: none; } }
    /* min-width 0 all the way down: without it a long unbreakable line (the
       share link) widens the column past the screen. */
    .step, .body { min-width: 0; }
    .body { flex: 1; }

    .brand { margin: 8px 0 22px; }
    .brand img { height: 30px; width: auto; }
    .chip {
      display: inline-block; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.07em;
      text-transform: uppercase; color: var(--g-deep); background: var(--g-tint);
      border-radius: 100px; padding: 6px 12px; margin-bottom: 14px;
    }
    h1 { font-size: clamp(1.9rem, 7.5vw, 2.4rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 800; text-wrap: balance; }
    .hl { color: var(--g); }
    .lead { color: var(--muted); margin-top: 12px; font-size: 1.08rem; line-height: 1.5; text-wrap: pretty; }
    h2 { font-size: clamp(1.5rem, 6.4vw, 1.8rem); line-height: 1.15; letter-spacing: -0.02em; font-weight: 800; text-wrap: balance; }
    h3 { font-size: 1.1rem; font-weight: 800; }

    .trust { list-style: none; margin-top: 22px; display: grid; gap: 10px; padding: 0; }
    .trust li { display: flex; align-items: center; gap: 10px; font-size: 1.02rem; font-weight: 650; color: var(--ink); }
    .tk { width: 24px; height: 24px; border-radius: 8px; background: var(--g-tint); color: var(--g-deep); display: grid; place-items: center; font-size: 0.8rem; font-weight: 900; }

    .options { display: grid; gap: 10px; margin-top: 18px; }
    .options.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
    .opt {
      font: inherit; text-align: left; cursor: pointer; background: var(--surface);
      border: 2px solid var(--line); border-radius: 14px; padding: 14px 16px; width: 100%; min-height: 58px;
      font-size: 1.06rem; font-weight: 650; color: var(--ink);
      transition: border-color .15s ease, background .15s ease, transform .1s ease;
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      -webkit-tap-highlight-color: transparent;
    }
    .opt-sm { min-height: 52px; padding: 12px 14px; font-size: 1rem; }
    .opt::after { content: "→"; color: #9aa89f; font-weight: 800; }
    .opt:active { transform: scale(0.98); background: var(--g-tint); }
    .opt:focus-visible { outline: 3px solid var(--g); outline-offset: 2px; }
    @media (hover: hover) { .opt:hover { border-color: var(--g); background: var(--g-tint); } }

    .multi-hint { font-size: 0.95rem; color: var(--muted); margin-top: 6px; }
    .multi-hint.on { color: var(--g-deep); font-weight: 700; }
    .opt-check::after { content: ""; flex: 0 0 auto; width: 22px; height: 22px; border: 2px solid #b8c4bb; border-radius: 7px; display: grid; place-items: center; font-size: 0.8rem; font-weight: 900; color: #fff; }
    .opt-check.selected { border-color: var(--g); background: var(--g-tint); }
    .opt-check.selected::after { content: "✓"; background: var(--g); border-color: var(--g); }

    /* The one action of each screen. On a phone it sticks to the bottom so a
       long list (bairros) never pushes it out of reach. */
    .actions { padding-top: 20px; }
    @media (max-width: 559px) {
      .actions {
        position: sticky; bottom: 0; margin: 0 -20px; padding: 18px 20px calc(16px + env(safe-area-inset-bottom));
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #fff 26%);
      }
    }
    .btn {
      display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%;
      font: inherit; font-weight: 800; font-size: 1.08rem; cursor: pointer; min-height: 56px;
      border-radius: 16px; padding: 14px 22px; text-decoration: none; border: 0;
      -webkit-tap-highlight-color: transparent;
    }
    .btn-primary { background: linear-gradient(135deg, var(--g) 0%, var(--g-deep) 100%); color: #fff; box-shadow: 0 10px 24px -12px rgba(43, 147, 72, 0.65); }
    .btn-primary:active { transform: scale(0.99); }
    .btn-wa { background: var(--wa); box-shadow: 0 10px 24px -12px rgba(31, 170, 85, 0.7); }
    .continue:disabled { opacity: 0.4; pointer-events: none; box-shadow: none; }

    .skip { display: block; margin-top: 14px; padding: 10px 0; text-align: center; color: var(--muted); font-size: 0.98rem; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

    .badge { display: inline-block; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--g-deep); background: var(--g-tint); border-radius: 100px; padding: 6px 12px; margin-bottom: 12px; }
    .result-intro { color: var(--muted); font-size: 1.02rem; line-height: 1.45; margin-top: 8px; font-weight: 600; }
    .result-intro:empty { display: none; }
    .outcomes { display: grid; gap: 12px; margin-top: 18px; }
    .oc { display: flex; align-items: flex-start; gap: 12px; font-size: 1.05rem; color: var(--ink); font-weight: 700; line-height: 1.4; }
    .oc[hidden] { display: none; }
    .ck { flex: 0 0 auto; width: 24px; height: 24px; border-radius: 8px; background: var(--g-tint); color: var(--g-deep); display: grid; place-items: center; font-weight: 900; font-size: 0.8rem; margin-top: 1px; }
    .note { margin-top: 20px; padding: 4px 0 4px 14px; border-left: 3px solid var(--amber); font-size: 0.98rem; color: var(--muted); line-height: 1.45; }
    .cta-note { margin-top: 10px; font-size: 0.92rem; color: var(--muted); text-align: center; }

    .again { display: inline-block; margin-top: 14px; padding: 8px 0; font-size: 1rem; font-weight: 700; color: var(--g-deep); text-decoration: underline; text-underline-offset: 3px; }
    .invite { margin-top: 26px; padding: 18px; border-radius: 16px; background: #f3f7f1; border: 1px solid var(--line); }
    .invite p { margin-top: 6px; font-size: 1rem; color: var(--muted); line-height: 1.45; }
    .link-box { margin-top: 12px; display: flex; align-items: center; gap: 8px; background: #fff; border: 1.5px solid var(--line); border-radius: 12px; padding: 6px 6px 6px 12px; }
    .link-box b { font-size: 1.1rem; letter-spacing: 0.04em; color: var(--g-deep); }
    .link-box span { flex: 1; min-width: 0; font-size: 0.95rem; font-weight: 700; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .copy { flex: 0 0 auto; min-height: 40px; padding: 0 14px; border-radius: 9px; border: 0; background: var(--g-tint); color: var(--g-deep); font: inherit; font-weight: 800; font-size: 0.95rem; cursor: pointer; }
  </style>

  <script define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY, waNumber: config.whatsappNumber }}>
    window.__SB = { url: sbUrl, key: sbKey };
    window.__TG_WA = waNumber;
  </script>

  <script>
    (function () {
      const steps = Array.from(document.querySelectorAll('.step'));
      const bar = document.getElementById('bar');
      const count = document.getElementById('count');
      const card = document.querySelector('.card');
      const back = document.getElementById('back');
      const answers = {};
      const TOTAL_Q = 5;
      const RESULT = 6;
      let cur = 0;

      // Personal referral link: tregou.app/entregador?ref=k7p2m. Kept to a
      // plain slug so it reads cleanly in the WhatsApp message.
      const ref = (function () {
        try {
          const raw = new URLSearchParams(location.search).get('ref') || '';
          const clean = raw.trim().toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 40);
          return clean || null;
        } catch (e) { return null; }
      })();

      // This courier's own code, to bring others. No look-alike characters, so
      // it survives being read out loud. Stable across reloads of the page.
      const ownCode = (function () {
        try {
          const kept = localStorage.getItem('tg_courier_code');
          if (kept) return kept;
        } catch (e) {}
        const abc = 'abcdefghjkmnpqrstuvwxyz23456789';
        let c = '';
        for (let i = 0; i < 5; i++) c += abc[Math.floor(Math.random() * abc.length)];
        try { localStorage.setItem('tg_courier_code', c); } catch (e) {}
        return c;
      })();
      const myLink = 'tregou.app/entregador?ref=' + ownCode;

      const LABEL = {
        work: { apps: 'iFood/apps', empresa: 'empresa de motoboy', restaurante: 'direto com restaurante', parado: 'parado agora' },
        hours: { almoco: 'almoço', tarde: 'tarde', jantar: 'jantar', noite: 'noite', fds: 'fim de semana' },
        vehicle: { ambos: 'moto e CNH', moto: 'só moto', cnh: 'só CNH', nenhum: 'sem moto e sem CNH' },
      };
      function items(q) {
        const v = answers[q];
        if (!v || !v.length) return [];
        const map = LABEL[q];
        return v.map(function (x) { return map ? (map[x] || x) : x; });
      }
      // "Bancários e Mangabeira" — a list read aloud, not a CSV.
      function joinPt(arr) {
        return arr.length < 2 ? arr.join('') : arr.slice(0, -1).join(', ') + ' e ' + arr[arr.length - 1];
      }
      function waUrl(text, to) {
        return 'https://wa.me/' + (to === undefined ? (window.__TG_WA || '') : to) + '?text=' + encodeURIComponent(text);
      }
      function waMessage() {
        const parts = ['Oi! Quero entrar na Rede Tregou.'];
        if (items('work').length) parts.push('Trabalho hoje: ' + items('work').join(', '));
        if (items('areas').length) parts.push('Bairros: ' + items('areas').join(', '));
        if (items('hours').length) parts.push('Horários: ' + items('hours').join(', '));
        if (answers.vehicle) parts.push('Moto/CNH: ' + LABEL.vehicle[answers.vehicle]);
        if (ref) parts.push('Indicação: ' + ref);
        parts.push('Meu código: ' + ownCode);
        return parts.join('\n');
      }

      const skip = document.getElementById('skip-wa');
      if (skip) skip.href = waUrl('Oi! Quero entrar na Rede Tregou.' + (ref ? '\nIndicação: ' + ref : '') + '\nMeu código: ' + ownCode);

      function show(n) {
        cur = Math.max(0, Math.min(steps.length - 1, n));
        steps.forEach((s, i) => s.classList.toggle('is-active', i === cur));
        const q = Math.min(cur, TOTAL_Q);
        bar.style.width = (cur >= RESULT ? 100 : (q / (TOTAL_Q + 1)) * 100) + '%';
        count.textContent = cur >= 1 && cur <= TOTAL_Q ? cur + '/' + TOTAL_Q : '';
        if (card) card.setAttribute('data-intro', String(cur === 0));
        back.hidden = cur === 0 || cur >= RESULT;
        if (cur === RESULT) { buildResult(); saveResponse(); }
        try { window.scrollTo({ top: 0 }); } catch (e) {}
      }

      document.querySelectorAll('[data-next]').forEach((b) =>
        b.addEventListener('click', () => show(cur + 1))
      );
      // Single choice: show the tap, then move on — a jump with no feedback
      // reads as a missed tap on a phone.
      document.querySelectorAll('.opt:not(.opt-check)').forEach((o) =>
        o.addEventListener('click', () => {
          answers[o.dataset.q] = o.dataset.val;
          o.classList.add('opt-check', 'selected');
          setTimeout(() => { o.classList.remove('opt-check', 'selected'); show(cur + 1); }, 180);
        })
      );

      document.querySelectorAll('.step').forEach((step) => {
        const checks = step.querySelectorAll('.opt-check');
        if (!checks.length) return;
        const q = checks[0].dataset.q;
        const set = new Set();
        const contBtn = step.querySelector('[data-continue]');
        const hint = step.querySelector('.multi-hint');
        const baseHint = hint ? hint.textContent : '';
        function sync(n) {
          if (contBtn) contBtn.textContent = n === 0 ? 'Continuar' : 'Continuar (' + n + ')';
          if (!hint) return;
          hint.textContent = n === 0 ? baseHint : 'Pode marcar mais, ou continuar.';
          hint.classList.toggle('on', n > 0);
        }
        checks.forEach((o) =>
          o.addEventListener('click', () => {
            const v = o.dataset.val;
            if (set.has(v)) { set.delete(v); o.classList.remove('selected'); }
            else { set.add(v); o.classList.add('selected'); }
            if (contBtn) contBtn.disabled = set.size === 0;
            sync(set.size);
          })
        );
        if (contBtn)
          contBtn.addEventListener('click', () => {
            answers[q] = Array.from(set);
            show(cur + 1);
          });
      });

      back.addEventListener('click', () => show(cur - 1));

      function buildResult() {
        const pains = answers.pain || [];
        document.querySelectorAll('.oc[data-when]').forEach(function (el) {
          el.hidden = pains.indexOf(el.getAttribute('data-when')) < 0;
        });
        const bits = [];
        if (items('areas').length) bits.push('Pra quem roda em ' + joinPt(items('areas')));
        if (items('hours').length) bits.push(joinPt(items('hours')));
        const intro = document.getElementById('result-intro');
        if (intro) intro.textContent = bits.length ? bits.join(' · ') + '.' : '';
        const url = waUrl(waMessage());
        document.getElementById('go-wa').href = url;
        document.getElementById('again-wa').href = url;
        document.getElementById('my-code').textContent = ownCode;
        document.getElementById('share-link').href = waUrl(
          'Tô entrando na Rede Tregou: entregas de restaurantes perto, você escolhe quais pegar e o valor é todo seu. Faz o pré-cadastro: https://' + myLink,
          ''
        );
      }

      function postResponse(extra) {
        const sb = window.__SB || {};
        if (!sb.url || !sb.key) return Promise.resolve(false);
        if (window.__tgMuted) return Promise.resolve(false);
        const body = {
          work: answers.work || null,
          pains: answers.pain || null,
          hours: answers.hours || null,
          areas: answers.areas || null,
          vehicle: answers.vehicle || null,
          ref: ref,
          own_code: ownCode,
          source: 'courier-quiz',
          referrer: document.referrer || null,
          user_agent: navigator.userAgent || null,
          session_id: window.__tgSid || null,
          visitor_id: window.__tgVid || null,
        };
        for (var k in (extra || {})) body[k] = extra[k];
        try {
          return fetch(sb.url.replace(/\/$/, '') + '/rest/v1/courier_leads', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: sb.key,
              Authorization: 'Bearer ' + sb.key,
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(body),
            keepalive: true,
          }).then(function (r) { return r.ok; }).catch(function () { return false; });
        } catch (e) { return Promise.resolve(false); }
      }

      // One row per visit when the result shows; a second row, flagged, when
      // the courier opens WhatsApp — "answered" and "went to pre-register" are
      // counted apart.
      let saved = false;
      function saveResponse() {
        if (saved) return;
        try {
          var visit = window.__tgSid;
          if (visit && localStorage.getItem('tg_courier_quiz_sent') === visit) { saved = true; return; }
          if (visit) localStorage.setItem('tg_courier_quiz_sent', visit);
        } catch (e) { /* storage blocked — worst case, one extra row */ }
        saved = true;
        if (window.__tgTrack) window.__tgTrack('milestone', 'courier_quiz_complete');
        postResponse();
      }

      // WhatsApp opens in its own app; when the courier comes back, the page
      // is already on "Pronto" with the link to bring others.
      let waSent = false;
      document.getElementById('go-wa').addEventListener('click', function () {
        if (!waSent) {
          waSent = true;
          if (window.__tgTrack) window.__tgTrack('cta_click', 'courier_whatsapp');
          postResponse({ whatsapp_opened: true, source: 'courier-quiz-whatsapp' });
        }
        setTimeout(function () { show(RESULT + 1); }, 400);
      });

      document.getElementById('copy-link').addEventListener('click', function (e) {
        const btn = e.currentTarget;
        const done = function () { btn.textContent = 'Link copiado'; setTimeout(function () { btn.textContent = 'Copiar'; }, 1600); };
        try { navigator.clipboard.writeText('https://' + myLink).then(done, done); } catch (err) { done(); }
      });
    })();
  </script>
</BaseLayout>
