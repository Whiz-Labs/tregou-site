---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

// Supabase (public anon key — safe to expose; RLS allows insert-only on quiz_responses).
// Set PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY in the env. If unset, the quiz
// still works and simply skips saving.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<BaseLayout
  title="Começar com o Tregou"
  description="Responda 5 perguntas rápidas e veja como o Tregou funciona pro seu negócio — distribuição de entregas automática, no prazo e no seu controle."
>
  <main class="quiz">
    <div class="card">
      <div class="bar" aria-hidden="true"><div class="bar-fill" id="bar"></div></div>

      <!-- 0 · INTRO -->
      <section class="step is-active" data-step="0">
        <div class="brand">
          <img src="/tregou-logo.png" alt="Tregou" height="30" />
        </div>
        <h1>Veja como o Tregou funciona <span class="hl">pro seu negócio</span></h1>
        <p class="lead">Responda 5 perguntas rápidas (leva 30 segundos) e a gente te mostra exatamente onde o Tregou te ajuda.</p>
        <button class="btn btn-primary" data-next>Começar →</button>
        <button class="skip" data-goto-result data-ready>Já sei que quero — criar conta grátis</button>
      </section>

      <!-- 1 -->
      <section class="step" data-step="1">
        <p class="q-count">Pergunta 1 de 5</p>
        <h2>Você já tem entregadores próprios?</h2>
        <div class="options">
          <button class="opt" data-q="fleet" data-val="sim">Sim, tenho minha equipe</button>
          <button class="opt" data-q="fleet" data-val="quero">Ainda não, mas quero montar</button>
          <button class="opt" data-q="fleet" data-val="app">Uso só app de entrega (iFood)</button>
        </div>
      </section>

      <!-- 2 -->
      <section class="step" data-step="2">
        <p class="q-count">Pergunta 2 de 5</p>
        <h2>Quantos entregadores na sua operação?</h2>
        <div class="options">
          <button class="opt" data-q="size" data-val="p">1 a 2</button>
          <button class="opt" data-q="size" data-val="m">3 a 5</button>
          <button class="opt" data-q="size" data-val="g">6 ou mais</button>
        </div>
      </section>

      <!-- 3 · pains (multi-select) -->
      <section class="step" data-step="3">
        <p class="q-count">Pergunta 3 de 5</p>
        <h2>O que mais te atrapalha hoje?</h2>
        <p class="multi-hint">Pode marcar mais de um.</p>
        <div class="options">
          <button class="opt opt-check" data-q="pain" data-val="decidir">Decidir quem leva cada pedido</button>
          <button class="opt opt-check" data-q="pain" data-val="atraso">Pedidos atrasando e cliente reclamando</button>
          <button class="opt opt-check" data-q="pain" data-val="visao">Não saber onde está cada entrega</button>
          <button class="opt opt-check" data-q="pain" data-val="equipe">Minha equipe não dá conta no pico</button>
        </div>
        <button class="btn btn-primary continue" data-continue disabled>Continuar</button>
      </section>

      <!-- 4 · what would help (multi-select) — surfaces Tregou's capabilities -->
      <section class="step" data-step="4">
        <p class="q-count">Pergunta 4 de 5</p>
        <h2>O que faria mais diferença pra você?</h2>
        <p class="multi-hint">Pode marcar mais de um.</p>
        <div class="options">
          <button class="opt opt-check" data-q="help" data-val="dispatch">Distribuir os pedidos sozinho, pro entregador certo</button>
          <button class="opt opt-check" data-q="help" data-val="rota">Guiar o entregador pela melhor rota, parada a parada</button>
          <button class="opt opt-check" data-q="help" data-val="tempo">Avisar o tempo de cada entrega e alertar atrasos</button>
          <button class="opt opt-check" data-q="help" data-val="mapa">Acompanhar os entregadores no mapa, ao vivo</button>
          <button class="opt opt-check" data-q="help" data-val="relatorios">Relatórios pra saber onde melhorar</button>
          <button class="opt opt-check" data-q="help" data-val="ia">Um assistente de IA que responde sobre seus números</button>
        </div>
        <button class="btn btn-primary continue" data-continue disabled>Continuar</button>
      </section>

      <!-- 5 · canal (multi-select) -->
      <section class="step" data-step="5">
        <p class="q-count">Pergunta 5 de 5</p>
        <h2>De onde vêm seus pedidos?</h2>
        <p class="multi-hint">Pode marcar mais de um.</p>
        <div class="options">
          <button class="opt opt-check" data-q="canal" data-val="ifood">iFood</button>
          <button class="opt opt-check" data-q="canal" data-val="whats">WhatsApp e telefone</button>
          <button class="opt opt-check" data-q="canal" data-val="apps">Outros apps (Rappi, 99…)</button>
          <button class="opt opt-check" data-q="canal" data-val="balcao">Balcão / retirada</button>
        </div>
        <button class="btn btn-primary continue" data-continue disabled>Continuar</button>
      </section>

      <!-- RESULT -->
      <section class="step" data-step="6">
        <div class="badge">Feito pro seu caso</div>
        <h2 id="result-title">O Tregou resolve exatamente isso</h2>
        <p class="result-intro" id="result-intro"></p>
        <div class="outcomes">
          <div class="oc"><span class="ck">✓</span><span>Menos atraso e menos reclamação de cliente</span></div>
          <div class="oc"><span class="ck">✓</span><span>Mais entregas com a mesma equipe — menos custo por pedido</span></div>
          <div class="oc"><span class="ck">✓</span><span>Menos tempo perdido decidindo e despachando</span></div>
          <div class="oc"><span class="ck">✓</span><span>Você enxerga tudo ao vivo, do preparo à porta</span></div>
        </div>
        <div class="founding">As <b>50 primeiras</b> a entrar viram <b>Fundadoras</b> — preço travado e IA liberada.</div>
        <a class="btn btn-primary btn-block" id="go-signup" data-base={config.signupLink} href={config.signupLink} target="_blank" rel="noopener noreferrer">Criar conta grátis</a>
        <a class="tlink" href={config.presentationLink} target="_blank" rel="noopener noreferrer">Ver a apresentação →</a>
        <div class="wa-form" id="wa-form">
          <label class="wa-label" for="wa-num">Prefere que a gente te chame? Deixe seu WhatsApp</label>
          <div class="wa-row">
            <input class="wa-input" id="wa-num" type="tel" inputmode="tel" autocomplete="tel" placeholder="(11) 99999-9999" />
            <button class="btn btn-primary wa-send" id="wa-send" type="button">Enviar</button>
          </div>
          <p class="wa-consent">Ao deixar seu WhatsApp, você aceita receber contato do Tregou sobre o produto. Opcional.</p>
          <p class="wa-sent">✓ Recebido! A gente entra em contato em breve. 💚</p>
        </div>
      </section>

      <button class="back" id="back" hidden>← Voltar</button>
    </div>
  </main>

  <style>
    .quiz {
      --g: #2b9348; --g-deep: #1b6e36; --g-tint: #e4f1e7; --amber: #f9c74f;
      --ink: #16211b; --muted: #5c6b62; --line: #e3ebe0;
      --bg: #f5f8f3; --surface: #ffffff;
      min-height: 100dvh; display: grid; place-items: safe center;
      background: radial-gradient(120% 80% at 80% -10%, var(--g-tint), var(--bg));
      padding: clamp(14px, 4vw, 28px); color: var(--ink);
    }
    .card {
      width: 100%; max-width: 560px; background: var(--surface);
      border: 1px solid var(--line); border-radius: 22px;
      padding: clamp(20px, 5vw, 44px); position: relative;
      box-shadow: 0 30px 70px -34px rgba(20, 60, 35, 0.4);
    }
    .bar { height: 6px; background: var(--g-tint); border-radius: 100px; overflow: hidden; margin-bottom: 26px; }
    .bar-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--g), var(--g-deep)); border-radius: 100px; transition: width .4s ease; }

    .step { display: none; }
    .step.is-active { display: block; animation: fade .35s ease; }
    @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .step.is-active { animation: none; } .bar-fill { transition: none; } }

    .brand { margin-bottom: 22px; }
    .brand img { height: 30px; width: auto; }

    h1 { font-size: clamp(1.6rem, 4.5vw, 2.3rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 700; text-wrap: balance; }
    .hl { color: var(--g); }
    .lead { color: var(--muted); margin-top: 12px; font-size: 1.05rem; }
    h2 { font-size: clamp(1.3rem, 3.6vw, 1.75rem); line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; text-wrap: balance; }
    .q-count { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--g-deep); margin-bottom: 8px; }

    .options { display: grid; gap: 11px; margin-top: 22px; }
    .opt {
      font: inherit; text-align: left; cursor: pointer; background: var(--surface);
      border: 1.5px solid var(--line); border-radius: 13px; padding: 16px 18px; width: 100%;
      font-size: 1.02rem; font-weight: 550; color: var(--ink);
      transition: border-color .18s ease, background .18s ease, box-shadow .18s ease, transform .12s ease;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .opt::after { content: "→"; color: var(--line); font-weight: 700; transition: color .15s, transform .15s; }
    .opt:hover { border-color: var(--g); background: var(--g-tint); }
    .opt:hover::after { color: var(--g); transform: translateX(3px); }
    .opt:active { transform: scale(0.985); }
    .opt:focus-visible { outline: 2px solid var(--g); outline-offset: 2px; }

    .multi-hint { font-size: 0.9rem; color: var(--muted); margin-top: 4px; }
    .opt-check::after { content: ""; width: 20px; height: 20px; border: 1.8px solid var(--line); border-radius: 6px; display: grid; place-items: center; font-size: 0.78rem; font-weight: 800; color: #fff; transition: background .15s, border-color .15s; }
    .opt-check:hover::after { transform: none; }
    .opt-check.selected { border-color: var(--g); background: var(--g-tint); box-shadow: 0 6px 18px -8px rgba(43, 147, 72, 0.45); }
    .opt-check.selected::after { content: "✓"; background: var(--g); border-color: var(--g); animation: chkpop .22s ease; }
    @keyframes chkpop { 0% { transform: scale(0.55); } 55% { transform: scale(1.12); } 100% { transform: scale(1); } }
    @media (prefers-reduced-motion: reduce) { .opt-check.selected::after { animation: none; } }
    .continue:disabled { opacity: 0.45; pointer-events: none; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      font: inherit; font-weight: 700; font-size: 1.02rem; cursor: pointer;
      border-radius: 13px; padding: 15px 26px; text-decoration: none; border: 1.5px solid transparent;
      transition: transform .12s, box-shadow .12s, background .12s;
    }
    .btn:hover { text-decoration: none; transform: translateY(-2px); }
    .btn-primary { background: var(--g); color: #fff; box-shadow: 0 12px 26px -12px rgba(43, 147, 72, 0.6); margin-top: 26px; }
    .btn-primary:hover { background: var(--g-deep); }
    .btn-outline { background: var(--surface); color: var(--g-deep); border-color: var(--line); }
    .btn-outline:hover { border-color: var(--g); background: var(--g-tint); }

    .skip { display: block; margin: 16px 0 0; padding: 0; text-align: left; background: none; border: none; color: var(--muted); font: inherit; font-size: 0.92rem; text-decoration: underline; cursor: pointer; }
    .skip:hover { color: var(--g-deep); }

    .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--g-deep); background: var(--g-tint); border: 1px solid var(--g); border-radius: 100px; padding: 5px 12px; margin-bottom: 12px; }
    .result-intro { color: var(--muted); font-size: 1rem; line-height: 1.5; margin-top: 4px; }
    .result-intro b { color: var(--ink); font-weight: 650; }
    .outcomes { display: grid; gap: 10px; margin: 16px 0 0; text-align: left; }
    .oc { display: flex; align-items: flex-start; gap: 11px; font-size: 0.98rem; color: var(--ink); font-weight: 600; line-height: 1.4; }
    .oc .ck { flex: 0 0 auto; width: 21px; height: 21px; border-radius: 7px; background: var(--g-tint); color: var(--g-deep); display: grid; place-items: center; font-weight: 800; font-size: 0.72rem; margin-top: 1px; }
    .founding { margin-top: 18px; padding: 3px 0 3px 14px; border-left: 3px solid var(--amber); font-size: 0.9rem; color: var(--muted); line-height: 1.45; }
    .founding b { color: var(--ink); font-weight: 700; }
    .btn-block { width: 100%; }
    .tlink { display: inline-block; margin-top: 14px; color: var(--g-deep); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
    .tlink:hover { text-decoration: underline; }
    .wa-form { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); text-align: left; }
    .wa-label { display: block; font-size: 0.9rem; font-weight: 600; color: var(--muted); margin-bottom: 8px; }
    .wa-row { display: flex; gap: 8px; }
    .wa-input { flex: 1; min-width: 0; font: inherit; font-size: 1rem; padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 12px; color: var(--ink); background: var(--surface); }
    .wa-input:focus { outline: none; border-color: var(--g); box-shadow: 0 0 0 3px var(--g-tint); }
    .wa-send { margin-top: 0; padding: 12px 22px; flex: 0 0 auto; }
    .wa-consent { font-size: 0.8rem; color: var(--muted); margin-top: 8px; line-height: 1.4; }
    .wa-sent { display: none; color: var(--g-deep); font-weight: 650; font-size: 0.95rem; margin-top: 4px; }
    .wa-form[data-sent="true"] .wa-label,
    .wa-form[data-sent="true"] .wa-row,
    .wa-form[data-sent="true"] .wa-consent { display: none; }
    .wa-form[data-sent="true"] .wa-sent { display: block; }
    @media (max-width: 420px) { .wa-row { flex-direction: column; } .wa-send { width: 100%; } }

    .back { position: absolute; top: 18px; right: 20px; background: none; border: none; color: var(--muted); font: inherit; font-size: 0.88rem; cursor: pointer; }
    .back:hover { color: var(--g-deep); }

    @media (max-width: 480px) { .actions .btn { flex-basis: 100%; } }
  </style>

  <script define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY }}>
    window.__SB = { url: sbUrl, key: sbKey };
  </script>

  <script>
    (function () {
      const steps = Array.from(document.querySelectorAll('.step'));
      const bar = document.getElementById('bar');
      const back = document.getElementById('back');
      const answers = {};
      const TOTAL_Q = 5; // questions 1..5; last step is the result
      let cur = 0;

      function show(n) {
        cur = Math.max(0, Math.min(steps.length - 1, n));
        steps.forEach((s, i) => s.classList.toggle('is-active', i === cur));
        bar.style.width = (cur / (TOTAL_Q + 1)) * 100 + '%';
        back.hidden = cur === 0 || cur === steps.length - 1;
        if (cur === steps.length - 1) { buildResult(); attributeSignup(); saveResponse(); }
        try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch (e) {}
      }

      // intro "Começar"
      document.querySelectorAll('[data-next]').forEach((b) =>
        b.addEventListener('click', () => show(cur + 1))
      );
      // intro "já quero" → jump to result (ready buyer)
      document.querySelectorAll('[data-ready]').forEach((b) =>
        b.addEventListener('click', () => show(steps.length - 1))
      );
      // single-choice options → record + advance
      document.querySelectorAll('.opt:not(.opt-check)').forEach((o) =>
        o.addEventListener('click', () => {
          answers[o.dataset.q] = o.dataset.val;
          show(cur + 1);
        })
      );

      // multi-choice steps (pain, help) → toggle, then "Continuar" (per step)
      document.querySelectorAll('.step').forEach((step) => {
        const checks = step.querySelectorAll('.opt-check');
        if (!checks.length) return;
        const q = checks[0].dataset.q;
        const set = new Set();
        const contBtn = step.querySelector('[data-continue]');
        checks.forEach((o) =>
          o.addEventListener('click', () => {
            const v = o.dataset.val;
            if (set.has(v)) { set.delete(v); o.classList.remove('selected'); }
            else { set.add(v); o.classList.add('selected'); }
            if (contBtn) contBtn.disabled = set.size === 0;
          })
        );
        if (contBtn)
          contBtn.addEventListener('click', () => {
            answers[q] = Array.from(set);
            show(cur + 1);
          });
      });

      back.addEventListener('click', () => show(cur - 1));

      const CANAL_SHORT = {
        ifood: 'iFood',
        whats: 'WhatsApp e telefone',
        apps: 'outros apps',
        balcao: 'balcão',
      };
      const OPEN = {
        sim: 'Pra um negócio que já tem equipe própria de entrega',
        quero: 'Pra quem está montando a própria equipe de entrega',
        app: 'Pra você ganhar autonomia além do app de entrega',
      };
      const SIZE = { p: 'com 1 a 2 entregadores', m: 'com 3 a 5 entregadores', g: 'com 6 ou mais entregadores' };

      // Result is a clean closing statement — the solutions were already shown
      // inline during step 3, as each pain was selected.
      function buildResult() {
        let intro = OPEN[answers.fleet] || 'Pro seu negócio';
        if (answers.size && answers.fleet !== 'app') intro += ', ' + SIZE[answers.size];
        if (answers.canal && answers.canal.length) {
          const cs = answers.canal.map(function (v) { return CANAL_SHORT[v]; }).filter(Boolean);
          if (cs.length) {
            const joined = cs.length === 1 ? cs[0] : cs.slice(0, -1).join(', ') + ' e ' + cs[cs.length - 1];
            intro += ', que recebe pedidos de ' + joined;
          }
        }
        intro += ' — o Tregou organiza tudo no automático.';
        const introEl = document.getElementById('result-intro');
        if (introEl) introEl.textContent = intro;
      }

      // Attribution: carry the answers into the signup link so a conversion
      // can be tied back to the quiz profile.
      function attributeSignup() {
        const a = document.getElementById('go-signup');
        if (!a || !a.dataset.base) return;
        const p = new URLSearchParams({ src: 'quiz' });
        if (answers.fleet) p.set('fleet', answers.fleet);
        if (answers.size) p.set('size', answers.size);
        if (answers.pain && answers.pain.length)
          p.set('pain', Array.isArray(answers.pain) ? answers.pain.join(',') : answers.pain);
        if (answers.help && answers.help.length)
          p.set('help', Array.isArray(answers.help) ? answers.help.join(',') : answers.help);
        if (answers.canal && answers.canal.length)
          p.set('canal', Array.isArray(answers.canal) ? answers.canal.join(',') : answers.canal);
        const base = a.dataset.base;
        a.href = base + (base.indexOf('?') >= 0 ? '&' : '?') + p.toString();
      }

      // Store the anonymous response in Supabase (insert-only via the public anon
      // key). Fire-and-forget: never blocks the UI, silently skips if unconfigured.
      // Post a response row to Supabase (insert-only via public anon key).
      // Fire-and-forget; no-ops if unconfigured. `extra` overrides base fields.
      function postResponse(extra) {
        const sb = window.__SB || {};
        if (!sb.url || !sb.key) return Promise.resolve(false);
        const body = {
          fleet: answers.fleet || null,
          size: answers.size || null,
          pains: answers.pain || null,
          help: answers.help || null,
          canal: answers.canal || null,
          source: 'landing-quiz',
          referrer: document.referrer || null,
          user_agent: navigator.userAgent || null,
        };
        for (var k in (extra || {})) body[k] = extra[k];
        try {
          return fetch(sb.url.replace(/\/$/, '') + '/rest/v1/quiz_responses', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: sb.key,
              Authorization: 'Bearer ' + sb.key,
              Prefer: 'return=minimal',
            },
            body: JSON.stringify(body),
            keepalive: true,
          }).then(function (r) { return r.ok; }).catch(function () { return false; });
        } catch (e) { return Promise.resolve(false); }
      }

      // Anonymous capture the moment the result shows (everyone, even bounces).
      let saved = false;
      function saveResponse() {
        if (saved) return;
        if (!answers.fleet && !answers.pain && !answers.help && !answers.size && !answers.canal) return;
        saved = true;
        postResponse();
      }

      // Optional WhatsApp contact — opt-in by voluntarily entering the number,
      // with the visible consent notice next to the field.
      (function () {
        const form = document.getElementById('wa-form');
        if (!form) return;
        const input = document.getElementById('wa-num');
        const btn = document.getElementById('wa-send');
        btn.addEventListener('click', function () {
          const num = (input.value || '').trim();
          if (num.replace(/\D/g, '').length < 10) { input.focus(); return; }
          btn.disabled = true;
          postResponse({ whatsapp: num, contact_consent: true, source: 'landing-quiz-contact' })
            .then(function () { form.setAttribute('data-sent', 'true'); });
        });
      })();
    })();
  </script>
</BaseLayout>
