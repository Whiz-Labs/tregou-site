---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

const pageTitle = 'Tregou — Entregas mais rápidas com rotas automáticas';
const pageDescription = 'Otimize suas entregas com rotas automáticas por endereço. Chega de pedidos atrasados e motoboys confusos. Atenda mais rápido no WhatsApp.';
const { whatsappLink } = config;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-container">
      <nav class="nav">
        <img src="/tregou-logo.png" alt="Tregou" class="nav-logo" />
        <a href={whatsappLink} class="nav-cta" target="_blank" rel="noopener">Fale conosco</a>
      </nav>

      <div class="hero-main">
      <div class="hero-content">
        <h1>Entregas mais <span class="gradient-text">rápidas</span> e <span class="gradient-text">inteligentes</span></h1>
        <p class="hero-subtitle">
          Distribua pedidos do iFood entre seus entregadores automaticamente.
          Rotas otimizadas para cada motoboy entregar mais em menos tempo.
        </p>
        <div class="hero-cta">
          <a href={whatsappLink} class="cta-button" target="_blank" rel="noopener">
            <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Começar agora
          </a>
          <span class="cta-hint">Converse com a gente no WhatsApp</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="devices-showcase">
          <!-- Laptop - Dashboard -->
          <div class="laptop-frame">
            <div class="laptop-screen">
              <div class="laptop-slider">
                <div class="laptop-track">
                  <!-- Dashboard Slide 1: Pedidos iFood -->
                  <div class="laptop-slide">
                    <div class="dashboard-screen">
                      <div class="dash-sidebar">
                        <div class="dash-logo">tregou</div>
                        <div class="dash-menu">
                          <div class="dash-menu-item active">
                            <span class="menu-icon">📋</span>
                            <span>Pedidos</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🚴</span>
                            <span>Motoboys</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🗺️</span>
                            <span>Rotas</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">📊</span>
                            <span>Relatórios</span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-main">
                        <div class="dash-header">
                          <span class="dash-title">Pedidos iFood</span>
                          <span class="dash-badge ifood">🔴 Sincronizado</span>
                        </div>
                        <div class="dash-orders">
                          <div class="dash-order">
                            <span class="order-id">#4521</span>
                            <span class="order-client">Carlos M.</span>
                            <span class="order-addr">Rua das Flores, 123</span>
                            <span class="order-tag pending">Atribuir</span>
                          </div>
                          <div class="dash-order">
                            <span class="order-id">#4520</span>
                            <span class="order-client">Ana Paula</span>
                            <span class="order-addr">Av. Brasil, 456</span>
                            <span class="order-tag progress">Ricardo</span>
                          </div>
                          <div class="dash-order">
                            <span class="order-id">#4519</span>
                            <span class="order-client">João S.</span>
                            <span class="order-addr">Rua Central, 89</span>
                            <span class="order-tag done">Entregue</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Dashboard Slide 2: Motoboys -->
                  <div class="laptop-slide">
                    <div class="dashboard-screen">
                      <div class="dash-sidebar">
                        <div class="dash-logo">tregou</div>
                        <div class="dash-menu">
                          <div class="dash-menu-item">
                            <span class="menu-icon">📋</span>
                            <span>Pedidos</span>
                          </div>
                          <div class="dash-menu-item active">
                            <span class="menu-icon">🚴</span>
                            <span>Motoboys</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🗺️</span>
                            <span>Rotas</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">📊</span>
                            <span>Relatórios</span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-main">
                        <div class="dash-header">
                          <span class="dash-title">Motoboys Ativos</span>
                          <span class="dash-badge success">3 online</span>
                        </div>
                        <div class="dash-couriers">
                          <div class="courier-item">
                            <div class="courier-avatar">R</div>
                            <div class="courier-info">
                              <span class="courier-name">Ricardo</span>
                              <span class="courier-status">4 entregas • 12km</span>
                            </div>
                            <span class="courier-badge active">Em rota</span>
                          </div>
                          <div class="courier-item">
                            <div class="courier-avatar">M</div>
                            <div class="courier-info">
                              <span class="courier-name">Marcos</span>
                              <span class="courier-status">3 entregas • 8km</span>
                            </div>
                            <span class="courier-badge active">Em rota</span>
                          </div>
                          <div class="courier-item">
                            <div class="courier-avatar">L</div>
                            <div class="courier-info">
                              <span class="courier-name">Lucas</span>
                              <span class="courier-status">0 entregas</span>
                            </div>
                            <span class="courier-badge available">Disponível</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="laptop-base"></div>
            <div class="device-label">Dashboard para Restaurantes</div>
          </div>

          <!-- Phone - Courier App -->
          <div class="phone-wrapper">
            <div class="phone-frame">
              <div class="phone-notch"></div>
              <div class="slider-container">
                <div class="slider-track">
                  <!-- Mobile Slide 1: Rota -->
                  <div class="slide">
                    <div class="app-screen">
                      <div class="app-header">
                        <span class="app-title">Minha Rota</span>
                        <span class="app-badge">3 entregas</span>
                      </div>
                      <div class="route-stops">
                        <div class="route-stop">
                          <div class="stop-marker">1</div>
                          <div class="stop-info">
                            <span class="stop-address">Rua das Flores, 123</span>
                            <span class="stop-time">10:30</span>
                          </div>
                        </div>
                        <div class="route-line-vertical"></div>
                        <div class="route-stop">
                          <div class="stop-marker">2</div>
                          <div class="stop-info">
                            <span class="stop-address">Av. Brasil, 456</span>
                            <span class="stop-time">10:45</span>
                          </div>
                        </div>
                        <div class="route-line-vertical"></div>
                        <div class="route-stop">
                          <div class="stop-marker">3</div>
                          <div class="stop-info">
                            <span class="stop-address">Rua do Comércio, 789</span>
                            <span class="stop-time">11:00</span>
                          </div>
                        </div>
                      </div>
                      <div class="app-footer">
                        <div class="app-stat">
                          <span class="stat-value">12 km</span>
                          <span class="stat-label">Total</span>
                        </div>
                        <div class="app-stat">
                          <span class="stat-value">30 min</span>
                          <span class="stat-label">Estimado</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Mobile Slide 2: Navegação -->
                  <div class="slide">
                    <div class="app-screen map-screen">
                      <div class="app-header">
                        <span class="app-title">Navegação</span>
                        <span class="app-badge live">Ao vivo</span>
                      </div>
                      <div class="map-placeholder">
                        <div class="map-route">
                          <div class="map-point start"></div>
                          <svg class="map-path" viewBox="0 0 200 150">
                            <path d="M20,120 Q60,120 80,80 T140,60 T180,30" stroke="url(#routeGradient)" stroke-width="3" fill="none" stroke-dasharray="8,4"/>
                            <defs>
                              <linearGradient id="routeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" style="stop-color:#22c55e"/>
                                <stop offset="100%" style="stop-color:#eab308"/>
                              </linearGradient>
                            </defs>
                          </svg>
                          <div class="map-point end"></div>
                        </div>
                      </div>
                      <div class="nav-info">
                        <div class="nav-detail">
                          <span class="nav-label">Próxima parada</span>
                          <span class="nav-value">Rua das Flores, 123</span>
                        </div>
                        <div class="nav-eta">
                          <span class="eta-time">5 min</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="slider-dots">
                <span class="dot"></span>
                <span class="dot"></span>
              </div>
            </div>
            <div class="device-label">App para Entregadores</div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how-it-works">
    <div class="container">
      <h2>Como funciona</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Sincroniza com iFood</h3>
          <p>Pedidos são importados automaticamente da sua conta iFood.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Distribui entre motoboys</h3>
          <p>Sistema divide os pedidos de forma inteligente entre sua equipe.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Otimiza cada rota</h3>
          <p>Cada motoboy recebe a melhor sequência de entregas no app.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="benefits">
    <div class="container">
      <div class="benefits-header">
        <h2>Por que usar o Tregou?</h2>
        <p>Transforme a logística do seu delivery</p>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Integração com iFood</h3>
          <p>Pedidos sincronizados automaticamente. Sem digitação manual de endereços.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3>Entregas mais rápidas</h3>
          <p>Rotas otimizadas para cada motoboy chegar mais rápido em cada entrega.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>Distribuição inteligente</h3>
          <p>Divide os pedidos entre sua equipe de forma equilibrada e eficiente.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3>Reduza custos</h3>
          <p>Menos quilômetros rodados significa economia em combustível.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <img src="/tregou-logo.png" alt="Tregou" class="cta-logo" />
        <h2>Otimize suas entregas do iFood</h2>
        <p>Fale com a gente e veja como o Tregou pode acelerar seu delivery.</p>
        <a href={whatsappLink} class="cta-button cta-button-large" target="_blank" rel="noopener">
          <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <img src="/tregou-logo.png" alt="Tregou" class="footer-logo" />
          <p>Entregas mais rápidas para seu negócio.</p>
        </div>
        <div class="footer-links">
          <a href="https://instagram.com/tregou.app" target="_blank" rel="noopener" class="social-link">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @tregou.app
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2025 Tregou. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Color Variables */
  :root {
    --color-dark: #1a2e35;
    --color-dark-lighter: #243b44;
    --color-green: #16a34a;
    --color-green-light: #22c55e;
    --color-yellow: #eab308;
    --color-yellow-light: #facc15;
    --color-white: #ffffff;
    --color-gray-50: #f9fafb;
    --color-gray-100: #f3f4f6;
    --color-gray-200: #e5e7eb;
    --color-gray-400: #9ca3af;
    --color-gray-600: #4b5563;
    --color-gray-800: #1f2937;
    --color-whatsapp: #25D366;
    --color-whatsapp-hover: #128C7E;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    position: relative;
    z-index: 10;
  }

  .nav-logo {
    height: 36px;
    width: auto;
  }

  @media (min-width: 768px) {
    .nav-logo {
      height: 44px;
    }
  }

  .nav-cta {
    color: var(--color-white);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 0.5rem;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.5);
    text-decoration: none;
  }

  /* Hero Section */
  .hero {
    background: linear-gradient(145deg, var(--color-dark) 0%, #0f1f24 100%);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at top right, rgba(22, 163, 74, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    padding: 4rem 0 6rem;
    max-width: 640px;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-green-light) 0%, var(--color-yellow) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-400);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--color-whatsapp);
    color: var(--color-white);
    padding: 1rem 1.75rem;
    border-radius: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4);
  }

  .cta-button:hover {
    background: var(--color-whatsapp-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
    text-decoration: none;
  }

  .whatsapp-icon {
    width: 22px;
    height: 22px;
  }

  .cta-hint {
