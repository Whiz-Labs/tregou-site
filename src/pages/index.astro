---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

const pageTitle = 'Tregou — Entregas mais rápidas com rotas automáticas';
const pageDescription = 'Otimize suas entregas com rotas automáticas por endereço. Chega de pedidos atrasados e motoboys confusos. Atenda mais rápido no WhatsApp.';
const { whatsappLink, presentationLink, signupLink } = config;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-container">
      <nav class="nav">
        <img src="/tregou-logo.png" alt="Tregou" class="nav-logo" />
        <div class="nav-actions">
          <a href={whatsappLink} class="nav-panel nav-hide-sm" data-ev="nav_whatsapp" target="_blank" rel="noopener">Fale conosco</a>
          <a href="https://panel.tregou.app" class="nav-panel" data-ev="nav_login" target="_blank" rel="noopener">Entrar</a>
          <a href={`${signupLink}?src=nav`} class="nav-cta" data-ev="nav_signup" target="_blank" rel="noopener">Criar conta grátis</a>
        </div>
      </nav>

      <div class="hero-main">
      <div class="hero-content">
        <!-- The founding offer used to live only in the footer, where most
             visitors never arrive. It is the strongest thing we have to say,
             so it goes above the headline. -->
        <a href={`${signupLink}?src=hero-vagas`} class="hero-flag" data-ev="hero_fundadoras" target="_blank" rel="noopener">
          <svg class="flag-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          <span class="flag-tx">Abrimos as <b>10 primeiras vagas</b> de Fundadora</span>
          <span class="flag-go" aria-hidden="true">→</span>
        </a>
        <h1>Entregas mais <span class="gradient-text">rápidas</span> e <span class="gradient-text">inteligentes</span></h1>
        <p class="hero-subtitle">
          Pra restaurantes, farmácias e qualquer negócio que entrega: seus pedidos do iFood,
          WhatsApp ou balcão vão pro entregador certo sozinhos, na melhor rota.
        </p>
        <div class="hero-cta">
          <div class="hero-buttons">
            <a href={`${signupLink}?src=hero`} class="cta-button cta-button-presentation" data-ev="hero_signup" target="_blank" rel="noopener">
              Criar conta grátis
              <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/comecar?src=hero" class="cta-button-secondary" data-ev="hero_quiz">
              Serve pro meu negócio?
              <span class="cta-badge">30s</span>
            </a>
          </div>
          <span class="cta-hint">Fundadora tem <b>60 dias grátis</b> e preço travado. Sem cartão, leva 2 minutos.</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="devices-showcase">
          <!-- Laptop - Dashboard -->
          <div class="laptop-frame">
            <div class="laptop-screen">
              <div class="laptop-slider">
                <div class="laptop-track">
                  <!-- Dashboard Slide 1: Pedidos iFood -->
                  <div class="laptop-slide">
                    <div class="dashboard-screen">
                      <div class="dash-sidebar">
                        <div class="dash-logo">tregou</div>
                        <div class="dash-menu">
                          <div class="dash-menu-item active">
                            <span class="menu-icon">📋</span>
                            <span>Pedidos</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🚴</span>
                            <span>Motoboys</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🗺️</span>
                            <span>Rotas</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">📊</span>
                            <span>Relatórios</span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-main">
                        <div class="dash-header">
                          <span class="dash-title">Pedidos</span>
                          <span class="dash-badge success">🟢 Ao vivo</span>
                        </div>
                        <div class="dash-split">
                          <div class="dash-orders">
                            <div class="dash-order">
                              <span class="order-id">#4521</span>
                              <span class="order-client">Carlos M.</span>
                              <span class="order-tag pending">Atribuir</span>
                            </div>
                            <div class="dash-order">
                              <span class="order-id">#4520</span>
                              <span class="order-client">Ana Paula</span>
                              <span class="order-tag progress">Ricardo</span>
                            </div>
                            <div class="dash-order">
                              <span class="order-id">#4519</span>
                              <span class="order-client">João S.</span>
                              <span class="order-tag done">Entregue</span>
                            </div>
                          </div>
                          <div class="dash-map">
                            <svg viewBox="0 0 120 90" preserveAspectRatio="none" aria-hidden="true">
                              <path d="M16,66 C 42,30 66,54 104,20" fill="none" stroke="#2b9348" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="4 5"/>
                            </svg>
                            <span class="m-pin a"></span>
                            <span class="m-pin b"></span>
                            <span class="m-courier"></span>
                            <span class="m-label">2 em rota</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Dashboard Slide 2: Relatórios + IA -->
                  <div class="laptop-slide">
                    <div class="dashboard-screen">
                      <div class="dash-sidebar">
                        <div class="dash-logo">tregou</div>
                        <div class="dash-menu">
                          <div class="dash-menu-item">
                            <span class="menu-icon">📋</span>
                            <span>Pedidos</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🚴</span>
                            <span>Motoboys</span>
                          </div>
                          <div class="dash-menu-item">
                            <span class="menu-icon">🗺️</span>
                            <span>Rotas</span>
                          </div>
                          <div class="dash-menu-item active">
                            <span class="menu-icon">📊</span>
                            <span>Relatórios</span>
                          </div>
                        </div>
                      </div>
                      <div class="dash-main">
                        <div class="dash-header">
                          <span class="dash-title">Relatórios</span>
                          <span class="dash-badge success">7 dias</span>
                        </div>
                        <div class="dash-stats">
                          <div class="dstat"><span class="dstat-v">94%</span><span class="dstat-k">No prazo</span></div>
                          <div class="dstat"><span class="dstat-v">312</span><span class="dstat-k">Entregas</span></div>
                          <div class="dstat"><span class="dstat-v">47</span><span class="dstat-k">Corridas econ.</span></div>
                        </div>
                        <div class="dash-ai">
                          <div class="dai-label"><span>✨</span> Assistente IA</div>
                          <div class="dai-q">Quantas entregas atrasaram?</div>
                          <div class="dai-a"><span class="dai-ic">✨</span><span>8 de 312 (2,6%), a maioria no Centro.</span></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="laptop-base"></div>
            <div class="device-label">Painel de controle</div>
          </div>

          <!-- Phone - Courier App -->
          <div class="phone-wrapper">
            <div class="phone-frame">
              <div class="phone-notch"></div>
              <div class="slider-container">
                <div class="slider-track">
                  <!-- Mobile Slide 1: Rota -->
                  <div class="slide">
                    <div class="app-screen">
                      <div class="app-header">
                        <span class="app-title">Minha Rota</span>
                        <span class="app-badge">3 entregas</span>
                      </div>
                      <div class="route-stops">
                        <div class="route-stop">
                          <div class="stop-marker">1</div>
                          <div class="stop-info">
                            <span class="stop-address">Rua das Flores, 123</span>
                            <span class="stop-time">10:30</span>
                          </div>
                        </div>
                        <div class="route-line-vertical"></div>
                        <div class="route-stop">
                          <div class="stop-marker">2</div>
                          <div class="stop-info">
                            <span class="stop-address">Av. Brasil, 456</span>
                            <span class="stop-time">10:45</span>
                          </div>
                        </div>
                        <div class="route-line-vertical"></div>
                        <div class="route-stop">
                          <div class="stop-marker">3</div>
                          <div class="stop-info">
                            <span class="stop-address">Rua do Comércio, 789</span>
                            <span class="stop-time">11:00</span>
                          </div>
                        </div>
                      </div>
                      <div class="app-footer">
                        <div class="app-stat">
                          <span class="stat-value">12 km</span>
                          <span class="stat-label">Total</span>
                        </div>
                        <div class="app-stat">
                          <span class="stat-value">30 min</span>
                          <span class="stat-label">Estimado</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Mobile Slide 2: Navegação -->
                  <div class="slide">
                    <div class="app-screen map-screen">
                      <div class="app-header">
                        <span class="app-title">Navegação</span>
                        <span class="app-badge live">Ao vivo</span>
                      </div>
                      <div class="map-placeholder">
                        <div class="map-route">
                          <div class="map-point start"></div>
                          <svg class="map-path" viewBox="0 0 200 150">
                            <path d="M20,120 Q60,120 80,80 T140,60 T180,30" stroke="url(#routeGradient)" stroke-width="3" fill="none" stroke-dasharray="8,4"/>
                            <defs>
                              <linearGradient id="routeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" style="stop-color:#2b9348"/>
                                <stop offset="100%" style="stop-color:#22c55e"/>
                              </linearGradient>
                            </defs>
                          </svg>
                          <div class="map-point end"></div>
                        </div>
                      </div>
                      <div class="nav-info">
                        <div class="nav-detail">
                          <span class="nav-label">Próxima parada</span>
                          <span class="nav-value">Rua das Flores, 123</span>
                        </div>
                        <div class="nav-eta">
                          <span class="eta-time">5 min</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="slider-dots">
                <span class="dot"></span>
                <span class="dot"></span>
              </div>
            </div>
            <div class="device-label">App para Entregadores</div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <!-- Value: o que sai das suas costas -->
  <section class="section section-tint">
    <div class="container">
      <span class="eyebrow">Menos peso, no automático</span>
      <h2 class="section-title">O que sai das suas costas</h2>
      <div class="value-grid">
        <div class="value-card">
          <div class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <h3>Chega de decidir quem leva cada pedido</h3>
          <p>O Tregou distribui sozinho pro entregador certo e junta as entregas do mesmo caminho.</p>
        </div>
        <div class="value-card">
          <div class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
          <h3>Chega de correr atrás de atraso</h3>
          <p>Cada pedido tem prazo: o sistema prioriza e remaneja sozinho se um entregador cai.</p>
        </div>
        <div class="value-card">
          <div class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg></div>
          <h3>Chega de guiar o entregador na rua</h3>
          <p>A melhor rota vai pronta pro app dele, com a próxima parada e o tempo sempre à vista.</p>
        </div>
        <div class="value-card">
          <div class="v-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"/><path d="M8 2v16M16 6v16"/></svg></div>
          <h3>Chega de "cadê meu pedido?"</h3>
          <p>Cada entregador aparece no mapa ao vivo, do preparo até a porta do cliente.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="section how-it-works">
    <div class="container">
      <span class="eyebrow">Como funciona</span>
      <h2 class="section-title">Do pedido à porta, no automático</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Recebe seus pedidos</h3>
          <p>Do iFood, WhatsApp ou balcão — entram automaticamente, sem digitar.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Distribui no automático</h3>
          <p>Manda cada pedido pro entregador certo, juntando os do mesmo caminho. Ou você atribui na mão.</p>
        </div>
        <div class="step-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Guia até a porta</h3>
          <p>O entregador recebe a melhor rota no app e você acompanha tudo no mapa, ao vivo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recursos / pilares -->
  <section class="section section-tint">
    <div class="container">
      <span class="eyebrow">Tudo em um só lugar</span>
      <h2 class="section-title">O sistema completo da sua operação</h2>
      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="p-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg></div>
          <h3>Distribuição inteligente</h3>
          <p>Automática ou manual: o Tregou distribui sozinho pelo melhor caminho — e você assume quando quiser.</p>
        </div>
        <div class="pillar-card">
          <div class="p-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg></div>
          <h3>App do entregador</h3>
          <p>Mapa ao vivo, próxima entrega em destaque e confirmação de entrega em um toque.</p>
        </div>
        <div class="pillar-card">
          <div class="p-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></div>
          <h3>Relatórios &amp; IA</h3>
          <p>Pontualidade, desempenho e onde melhorar — com um assistente de IA que responde sobre seus números.</p>
        </div>
        <div class="pillar-card is-soon">
          <span class="soon-badge">Em breve</span>
          <div class="p-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg></div>
          <h3>Cardápio com IA</h3>
          <p>Pra restaurantes: monte seu cardápio a partir de uma foto. Liberação gradual, começando pelas Fundadoras.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <img src="/tregou-logo.png" alt="Tregou" class="cta-logo" />
        <h2>Comece hoje — é grátis pra testar</h2>
        <p>Crie sua conta e veja o Tregou distribuindo seus pedidos hoje mesmo. Sem cartão, sem compromisso.</p>
        <div class="founding-note"><span class="fn-ic">🔥</span><span class="fn-tx">Estamos abrindo as <b>10 primeiras vagas</b>. Quem entra agora vira <b class="w">Fundadora</b>: <b>60 dias grátis</b>, a gente configura sua operação junto com você e seu <b>preço fica travado pra sempre</b>.</span></div>
        <div class="cta-actions">
          <a href={`${signupLink}?src=footer`} class="cta-button cta-button-presentation cta-button-large" data-ev="footer_signup" target="_blank" rel="noopener">
            Criar conta grátis
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href={whatsappLink} class="cta-button-wa" data-ev="footer_whatsapp" target="_blank" rel="noopener">
            <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Tirar dúvidas no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <img src="/tregou-logo.png" alt="Tregou" class="footer-logo" />
          <p>Entregas mais rápidas para seu negócio.</p>
        </div>
        <div class="footer-links">
          <a href={presentationLink} target="_blank" rel="noopener" class="footer-link" data-ev="footer_deck">Ver a apresentação</a>
          <a href="https://instagram.com/tregou.app" target="_blank" rel="noopener" class="social-link">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            @tregou.app
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2025 Tregou. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Color Variables */
  :root {
    --color-dark: #1a2e35;
    --color-dark-lighter: #243b44;
    --color-green: #2b9348;
    --color-green-light: #22c55e;
    --color-yellow: #f9c74f;
    --color-yellow-light: #facc15;
    --color-white: #ffffff;
    --color-gray-50: #f9fafb;
    --color-gray-100: #f3f4f6;
    --color-gray-200: #e5e7eb;
    --color-gray-400: #9ca3af;
    --color-gray-600: #4b5563;
    --color-gray-800: #1f2937;
    --color-whatsapp: #25D366;
    --color-whatsapp-hover: #128C7E;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    position: relative;
    z-index: 10;
  }

  .nav-logo {
    height: 36px;
    width: auto;
  }

  @media (min-width: 768px) {
    .nav-logo {
      height: 44px;
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-panel {
    color: var(--color-white);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    transition: all 0.2s;
    white-space: nowrap;
    opacity: 0.8;
  }

  .nav-panel:hover {
    opacity: 1;
    text-decoration: none;
  }

  .nav-cta {
    color: var(--color-white);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 0.5rem;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.5);
    text-decoration: none;
  }

  /* Hero Section */
  .hero {
    background: linear-gradient(145deg, var(--color-dark) 0%, #0f1f24 100%);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at top right, rgba(43, 147, 72, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    padding: 4rem 0 6rem;
    max-width: 640px;
  }

  /* Founding-cohort flag. Amber against the dark hero so it reads before the
     headline, but it stays a pill — it announces the offer, the button below
     is still what converts. */
  .hero-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.45rem 0.5rem 0.45rem 0.75rem;
    border-radius: 100px;
    background: rgba(249, 199, 79, 0.12);
    border: 1px solid rgba(249, 199, 79, 0.42);
    color: var(--color-gray-200);
    font-size: 0.875rem;
    line-height: 1.3;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .hero-flag:hover {
    background: rgba(249, 199, 79, 0.2);
    border-color: rgba(249, 199, 79, 0.75);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .hero-flag b {
    color: var(--color-yellow);
    font-weight: 700;
  }

  /* Only the flame breathes — a pill that moves as a whole would fight the
     headline for attention. */
  .flag-ic {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    color: var(--color-yellow);
    animation: flameGlow 2.6s ease-in-out infinite;
  }

  .flag-go {
    color: var(--color-yellow);
    opacity: 0.75;
    transition: transform 0.2s;
  }

  .hero-flag:hover .flag-go {
    transform: translateX(2px);
    opacity: 1;
  }

  @keyframes flameGlow {
    0%, 100% { transform: scale(1); filter: none; }
    50% { transform: scale(1.12); filter: drop-shadow(0 0 6px rgba(249, 199, 79, 0.7)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flag-ic { animation: none; }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-green-light) 0%, var(--color-yellow) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-400);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    /* stretch, not center: if they wrap onto separate rows the two buttons keep
       the same height instead of reading as two unrelated sizes. */
    align-items: stretch;
  }

  .cta-button-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-white);
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.04);
    transition: all 0.2s;
  }

  .cta-button-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .cta-button-secondary .arrow-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s;
  }

  .cta-button-secondary:hover .arrow-icon {
    transform: translateX(3px);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--color-whatsapp);
    color: var(--color-white);
    padding: 1rem 1.75rem;
    border-radius: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4);
  }

  .cta-button:hover {
    background: var(--color-whatsapp-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
    text-decoration: none;
  }

  .cta-button-presentation {
    background: linear-gradient(135deg, #2b9348 0%, #1b6e36 100%);
    color: #fff;
    box-shadow: 0 4px 14px rgba(43, 147, 72, 0.35);
  }

  .cta-button-presentation:hover {
    background: linear-gradient(135deg, #1b6e36 0%, #166534 100%);
    box-shadow: 0 6px 20px rgba(43, 147, 72, 0.45);
  }

  .cta-button-presentation .arrow-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.2s;
  }

  .cta-button-presentation:hover .arrow-icon {
    transform: translateX(3px);
  }

  .whatsapp-icon {
    width: 22px;
    height: 22px;
  }

  .cta-hint {
    font-size: 0.875rem;
    color: var(--color-gray-400);
  }

  .cta-hint b {
    color: var(--color-gray-200);
    font-weight: 600;
  }

  /* Time cost, worn by the secondary CTA — the quiz only competes with signup
     if the visitor thinks it's long. */
  .cta-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.75);
  }

  .cta-button-secondary:hover .cta-badge {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  @media (max-width: 560px) {
    .nav-hide-sm {
      display: none;
    }

    /* Stacked buttons of different widths read as ragged — match them. */
    .hero-buttons {
      width: 100%;
    }

    .hero-buttons > a {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  /* Hero Visual - Route Card */
  .hero-visual {
    display: none;
  }

  .hero-main {
    display: block;
  }

  @media (min-width: 1200px) {
    .hero-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .hero-content {
      padding: 2rem 0 4rem;
    }

    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem 0;
    }
  }

  /* Devices Showcase */
  .devices-showcase {
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    position: relative;
  }

  .device-label {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--color-gray-400);
    font-weight: 500;
  }

  /* Laptop Frame */
  .laptop-frame {
    display: none;
  }

  @media (min-width: 1200px) {
    .laptop-frame {
      display: block;
    }
  }

  .laptop-screen {
    width: 348px;
    height: 244px;
    background: #1a1a1a;
    border-radius: 8px 8px 0 0;
    padding: 6px;
    border: 2px solid #333;
  }

  .laptop-slider {
    width: 100%;
    height: 100%;
    background: var(--color-white);
    border-radius: 4px;
    overflow: hidden;
  }

  .laptop-track {
    display: flex;
    width: 200%;
    height: 100%;
    animation: laptop-slide 10s ease-in-out infinite;
  }

  @keyframes laptop-slide {
    0%, 42% { transform: translateX(0); }
    50%, 92% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .laptop-slide {
    width: 50%;
    height: 100%;
  }

  .laptop-base {
    width: 420px;
    height: 12px;
    background: linear-gradient(to bottom, #333 0%, #1a1a1a 100%);
    border-radius: 0 0 8px 8px;
    margin-left: -20px;
  }

  /* Dashboard Screen */
  .dashboard-screen {
    display: flex;
    height: 100%;
    font-size: 0.625rem;
  }

  .dash-sidebar {
    width: 80px;
    background: var(--color-dark);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dash-logo {
    color: var(--color-green);
    font-weight: 700;
    font-size: 0.6875rem;
    padding: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .dash-menu {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dash-menu-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem;
    border-radius: 0.25rem;
    color: var(--color-gray-400);
    font-size: 0.5625rem;
  }

  .dash-menu-item.active {
    background: rgba(43, 147, 72, 0.2);
    color: var(--color-green);
  }

  .menu-icon {
    font-size: 0.625rem;
  }

  .dash-main {
    flex: 1;
    padding: 0.75rem;
    background: var(--color-gray-50);
  }

  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.625rem;
  }

  .dash-title {
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--color-gray-800);
  }

  .dash-badge {
    background: rgba(234, 179, 8, 0.1);
    color: var(--color-yellow);
    padding: 0.125rem 0.375rem;
    border-radius: 0.75rem;
    font-size: 0.5rem;
    font-weight: 600;
  }

  .dash-badge.success {
    background: rgba(43, 147, 72, 0.1);
    color: var(--color-green);
  }

  .dash-orders {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .dash-order {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: white;
    border-radius: 0.375rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  /* Orders + live map side by side (mirrors the real dashboard) */
  .dash-split {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  .dash-split .dash-orders {
    flex: 1;
    min-width: 0;
  }
  .dash-map {
    flex: 1.1;
    position: relative;
    overflow: hidden;
    border-radius: 0.375rem;
    border: 1px solid var(--color-gray-200);
    background:
      radial-gradient(circle at 30% 25%, rgba(43, 147, 72, 0.12), transparent 60%),
      #eaf1ec;
    min-height: 92px;
  }
  .dash-map svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dash-map .m-pin {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 50% 50% 50% 2px;
    transform: rotate(45deg);
    border: 1.5px solid #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }
  .dash-map .m-pin.a { background: #2b9348; top: 20%; left: 20%; }
  .dash-map .m-pin.b { background: #0d9488; top: 58%; left: 62%; }
  .dash-map .m-courier {
    position: absolute;
    top: 42%;
    left: 40%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2f7be0;
    border: 2px solid #fff;
    box-shadow: 0 0 0 3px rgba(47, 123, 224, 0.22);
  }
  .dash-map .m-label {
    position: absolute;
    bottom: 5px;
    left: 5px;
    font-size: 0.4rem;
    font-weight: 700;
    color: var(--color-green);
    background: rgba(255, 255, 255, 0.9);
    padding: 1px 5px;
    border-radius: 100px;
  }

  /* Relatórios + IA slide */
  .dash-stats { display: flex; gap: 0.4rem; margin-bottom: 0.55rem; }
  .dstat { flex: 1; background: #fff; border-radius: 0.4rem; padding: 0.45rem 0.5rem; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .dstat-v { display: block; font-size: 0.8rem; font-weight: 800; color: var(--color-green); line-height: 1; }
  .dstat-k { display: block; font-size: 0.38rem; color: var(--color-gray-500); text-transform: uppercase; letter-spacing: 0.03em; margin-top: 0.25rem; }
  .dash-ai { display: flex; flex-direction: column; gap: 0.3rem; }
  .dai-label { display: flex; align-items: center; gap: 0.2rem; font-size: 0.42rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-green); margin-bottom: 0.05rem; }
  .dai-q { align-self: flex-end; background: var(--color-green); color: #fff; font-size: 0.46rem; line-height: 1.3; padding: 0.3rem 0.5rem; border-radius: 0.5rem 0.5rem 0.15rem 0.5rem; max-width: 82%; }
  .dai-a { align-self: flex-start; background: #fff; color: var(--color-gray-700); font-size: 0.46rem; line-height: 1.3; padding: 0.3rem 0.5rem; border-radius: 0.5rem 0.5rem 0.5rem 0.15rem; max-width: 92%; box-shadow: 0 1px 2px rgba(0,0,0,0.05); display: flex; gap: 0.28rem; align-items: flex-start; }
  .dai-ic { color: var(--color-green); flex: 0 0 auto; }

  .order-id {
    font-weight: 600;
    color: var(--color-gray-800);
    font-size: 0.5625rem;
  }

  .order-client {
    flex: 1;
    color: var(--color-gray-600);
    font-size: 0.5625rem;
  }

  .order-addr {
    color: var(--color-gray-400);
    font-size: 0.5rem;
    flex: 1;
  }

  .order-tag {
    font-size: 0.4375rem;
    font-weight: 600;
    padding: 0.125rem 0.3rem;
    border-radius: 0.25rem;
  }

  .order-tag.pending {
    background: rgba(234, 179, 8, 0.1);
    color: var(--color-yellow);
  }

  .order-tag.progress {
    background: rgba(13, 148, 136, 0.12);
    color: #0d9488;
  }

  .order-tag.done {
    background: rgba(43, 147, 72, 0.1);
    color: var(--color-green);
  }

  .dash-badge.ifood {
    background: rgba(234, 67, 53, 0.1);
    color: #ea4335;
  }

  /* Dashboard Couriers */
  .dash-couriers {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .courier-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: white;
    border-radius: 0.375rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .courier-avatar {
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, var(--color-green) 0%, var(--color-green-light) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.5rem;
    font-weight: 700;
  }

  .courier-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
  }

  .courier-name {
    font-size: 0.5625rem;
    font-weight: 600;
    color: var(--color-gray-800);
  }

  .courier-status {
    font-size: 0.4375rem;
    color: var(--color-gray-400);
  }

  .courier-badge {
    font-size: 0.4375rem;
    font-weight: 600;
    padding: 0.125rem 0.3rem;
    border-radius: 0.25rem;
  }

  .courier-badge.active {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  .courier-badge.available {
    background: rgba(43, 147, 72, 0.1);
    color: var(--color-green);
  }

  /* Phone Frame */
  .phone-wrapper {
    position: relative;
  }

  .phone-frame {
    width: 176px;
    background: #000;
    border-radius: 28px;
    padding: 6px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
    position: relative;
  }

  .phone-notch {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 18px;
    background: #000;
    border-radius: 10px;
    z-index: 10;
  }

  .slider-container {
    background: var(--color-white);
    border-radius: 22px;
    overflow: hidden;
    height: 360px;
  }

  .slider-track {
    display: flex;
    width: 200%;
    height: 100%;
    animation: slide 8s ease-in-out infinite;
  }

  @keyframes slide {
    0%, 42% { transform: translateX(0); }
    50%, 92% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .slide {
    width: 50%;
    height: 100%;
  }

  .app-screen {
    height: 100%;
    padding: 2.25rem 1rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .app-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .app-title {
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--color-gray-800);
  }

  .app-badge {
    background: rgba(43, 147, 72, 0.1);
    color: var(--color-green);
    padding: 0.2rem 0.5rem;
    border-radius: 1rem;
    font-size: 0.5625rem;
    font-weight: 600;
  }

  .app-badge.live {
    animation: pulse-badge 2s ease-in-out infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .route-stops {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex: 1;
  }

  .route-stop {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  .stop-marker {
    width: 20px;
    height: 20px;
    background: linear-gradient(135deg, var(--color-green) 0%, var(--color-green-light) 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.5625rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .stop-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: 1;
  }

  .stop-address {
    font-size: 0.625rem;
    color: var(--color-gray-800);
  }

  .stop-time {
    font-size: 0.5625rem;
    color: var(--color-gray-400);
    font-weight: 500;
  }

  .route-line-vertical {
    width: 2px;
    height: 10px;
    background: var(--color-gray-200);
    margin-left: 9px;
  }

  .app-footer {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .app-stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-green);
  }

  .stat-label {
    font-size: 0.5rem;
    color: var(--color-gray-400);
  }

  /* Map Screen */
  .map-placeholder {
    flex: 1;
    background: linear-gradient(145deg, #e8f5e9 0%, #f5f5f5 100%);
    border-radius: 0.5rem;
    position: relative;
    overflow: hidden;
    margin-bottom: 0.625rem;
  }

  .map-route {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-path {
    width: 100%;
    height: 100%;
  }

  .map-point {
    position: absolute;
    width: 8px;
    height: 8px;
