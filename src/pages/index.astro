---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

const pageTitle = 'Tregou — Suas entregas no automático';
const pageDescription = 'Pedido do iFood, WhatsApp ou balcão vai sozinho pro entregador certo, na melhor rota. Entregador? Entre na Rede Tregou.';
const { whatsappLink, whatsappNumber, signupLink, privacyLink } = config;

// A business that isn't ready to sign up gets a conversation, not a form:
// the message is typed for them, they only press send.
const waBusiness = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  'Oi! Tenho um negócio e quero saber se o Tregou serve pra mim.'
)}`;

// The landing is a fork, not a brochure: a business goes to sign-up, a courier
// goes to the Rede pre-registration. Everything else on the page is there to
// make one of those two clicks easier.
const fonts =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap';
---

<BaseLayout title={pageTitle} description={pageDescription} fontsHref={fonts}>
  <section class="hero">
    <div class="wrap">
      <nav class="nav">
        <img src="/brand/tregou-wordmark.svg" alt="Tregou" class="nav-logo" width="116" height="30" />
        <div class="nav-actions">
          <a href={whatsappLink} class="nav-link hide-sm" data-ev="nav_whatsapp" target="_blank" rel="noopener">Fale conosco</a>
          <a href="https://panel.tregou.app" class="nav-pill" data-ev="nav_login" target="_blank" rel="noopener">Entrar</a>
        </div>
      </nav>

      <div class="hero-main">
        <div class="hero-copy">
          <h1>Suas entregas no <span class="accent">automático</span>.</h1>
          <p class="lede">Pedido do iFood, WhatsApp ou balcão vai sozinho pro entregador certo, na melhor rota.</p>

          <div class="doors">
            <div class="door-col">
              <!-- data-ev stays "hero_signup" so the click rate compares with
                   the previous landing's hero button. -->
              <a href={`${signupLink}?src=hero`} class="door door-business" data-ev="hero_signup" target="_blank" rel="noopener">
                <span class="door-text">
                  <span class="door-kicker">Tenho um negócio</span>
                  <span class="door-title">Criar conta grátis</span>
                  <span class="door-sub">Sem cartão · leva 2 minutos</span>
                </span>
                <span class="door-arrow" aria-hidden="true">→</span>
              </a>
              <a href={waBusiness} class="wa-btn" data-ev="hero_whatsapp" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="#25D366" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Tirar dúvidas no WhatsApp
              </a>
            </div>
            <a href="/entregador?src=home" class="door door-courier" data-ev="hero_courier">
              <span class="door-text">
                <span class="door-kicker">Sou entregador</span>
                <span class="door-title">Entrar na Rede Tregou</span>
                <span class="door-sub">30 segundos · sem documentos</span>
              </span>
              <span class="door-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Product visual: the panel's Operação view and the courier's offer.
             Drawn in markup, kept to what both screens really show. -->
        <div class="visual" aria-hidden="true">
          <div class="panel">
            <div class="panel-rail">
              <img src="/brand/tregou-icon-dark-neon.svg" alt="" width="30" height="30" />
              <span class="rail-dot on"></span>
              <span class="rail-dot"></span>
              <span class="rail-dot"></span>
            </div>
            <div class="panel-body">
              <div class="panel-head">
                <span class="panel-title">Operação</span>
                <span class="live"><i></i>Ao vivo</span>
              </div>
              <div class="panel-split">
                <div class="orders">
                  <div class="order">
                    <b>#4521 · Carlos</b>
                    <span>Pronto · Bessa</span>
                    <em class="chip chip-green">Oferta enviada</em>
                  </div>
                  <div class="order">
                    <b>#4520 · Ana</b>
                    <span>Em entrega · Manaíra</span>
                    <em class="chip chip-amber">12 min</em>
                  </div>
                  <div class="order">
                    <b>#4519 · João</b>
                    <span>Entregue</span>
                  </div>
                </div>
                <div class="map">
                  <svg viewBox="0 0 300 280" preserveAspectRatio="xMidYMid slice">
                    <path d="M0 70 H300 M0 170 H300 M0 240 H300 M60 0 V280 M150 0 V280 M235 0 V280" stroke="#fff" stroke-width="10" />
                    <path d="M60 240 C 60 170, 150 190, 150 120 S 235 70, 235 40" fill="none" stroke="#088A5F" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 10" />
                    <circle cx="60" cy="240" r="11" fill="#1F2A30" />
                    <circle cx="150" cy="120" r="9" fill="#fff" stroke="#088A5F" stroke-width="4" />
                    <circle cx="235" cy="40" r="9" fill="#fff" stroke="#088A5F" stroke-width="4" />
                    <circle cx="112" cy="170" r="10" fill="#2F6FEB" stroke="#fff" stroke-width="4" />
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <div class="phone">
            <div class="phone-screen">
              <div class="phone-map">
                <svg viewBox="0 0 214 170">
                  <path d="M0 50 H214 M0 120 H214 M70 0 V170 M150 0 V170" stroke="#fff" stroke-width="9" />
                  <path d="M70 150 C 70 100, 150 110, 150 50" fill="none" stroke="#088A5F" stroke-width="5" stroke-linecap="round" />
                  <circle cx="70" cy="150" r="9" fill="#2F6FEB" stroke="#fff" stroke-width="3" />
                  <circle cx="150" cy="50" r="8" fill="#fff" stroke="#088A5F" stroke-width="4" />
                </svg>
              </div>
              <div class="offer">
                <div class="offer-head">
                  <span class="offer-kicker">Nova entrega</span>
                  <span class="chip chip-amber">0:48</span>
                </div>
                <span class="offer-route">Bessa → Manaíra</span>
                <span class="offer-meta">2,4 km · 1 entrega</span>
                <div class="offer-actions">
                  <span class="btn-ghost">Recusar</span>
                  <span class="btn-accept">Aceitar</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="steps-section">
    <div class="wrap">
      <h2>Do pedido à porta, sem você no meio.</h2>
      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <span class="step-text"><b>O pedido entra</b>iFood, WhatsApp ou balcão. Sem digitar de novo.</span>
        </li>
        <li>
          <span class="step-n">2</span>
          <span class="step-text"><b>Vai pro entregador certo</b>Sozinho, juntando os pedidos do mesmo caminho.</span>
        </li>
        <li>
          <span class="step-n">3</span>
          <span class="step-text"><b>Chega na porta</b>Rota pronta no app dele. Você vê tudo no mapa.</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- The quiz, for the business that would rather not talk to anyone yet
       (or arrives after hours). Below the fold on purpose: third in line
       after sign-up and WhatsApp. -->
  <section class="quiz-section">
    <div class="wrap">
      <div class="quiz-band">
        <div>
          <b>Não sabe se serve pro seu negócio?</b>
          <span>5 perguntas, 30 segundos. No fim você vê como ficaria pra você.</span>
        </div>
        <a href="/comecar?src=home" class="quiz-btn" data-ev="band_quiz">Fazer o teste →</a>
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="wrap">
      <div class="closing">
        <div class="closing-copy">
          <h2>Comece hoje. Sem cartão, sem compromisso.</h2>
          <p>Crie sua conta em 2 minutos e veja seus pedidos indo sozinhos pro entregador certo.</p>
        </div>
        <div class="closing-actions">
          <a href={`${signupLink}?src=footer`} class="btn-primary" data-ev="footer_signup" target="_blank" rel="noopener">Criar conta grátis</a>
          <a href={waBusiness} class="btn-secondary" data-ev="footer_whatsapp" target="_blank" rel="noopener">Falar no WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap footer-row">
      <img src="/brand/tregou-wordmark-light.svg" alt="Tregou" class="footer-logo" width="86" height="22" />
      <div class="footer-links">
        <a href={privacyLink} target="_blank" rel="noopener">Privacidade</a>
        <a href="https://instagram.com/tregou.app" target="_blank" rel="noopener">Instagram</a>
        <span>© {new Date().getFullYear()} Tregou</span>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Two layers (brand rule): the hero is the energetic brand moment — slate
     ground, neon from the logo arrow; the rest is the calm work surface —
     warm neutral, emerald buttons. */
  :global(:root) {
    --slate: #1f2a30;
    --slate-2: #26343b;
    --slate-line: #3b4b52;
    --on-slate: #f4f7f5;
    --on-slate-muted: #b9c6c0;
    --on-slate-faint: #8fa39a;
    --neon: #1fc46e;
    --ink-on-neon: #0b1a12;
    --emerald-700: #07734f;
    --emerald-600: #088a5f;
    --ground: #f6f5f1;
    --card: #ffffff;
    --line: #e7e6e1;
    --ink: #1f2a30;
    --ink-muted: #4a5a54;
    --ink-faint: #5b6b64;
    --display: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
    --body: 'Figtree', system-ui, -apple-system, sans-serif;
  }

  :global(body) {
    font-family: var(--body);
    background: var(--ground);
    color: var(--ink);
  }

  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: none; }

  .wrap {
    width: 100%;
    max-width: 1248px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) { .wrap { padding-inline: 48px; } }

  /* ---------- Hero ---------- */
  .hero {
    background: var(--slate);
    color: var(--on-slate);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    right: -180px;
    top: -220px;
    width: 760px;
    height: 760px;
    border-radius: 50%;
    background: #243a33;
    opacity: 0.55;
    pointer-events: none;
  }

  .nav {
    position: relative;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  @media (min-width: 768px) { .nav { height: 88px; } }
  .nav-logo { height: 24px; width: auto; }
  @media (min-width: 768px) { .nav-logo { height: 30px; } }
  .nav-actions { display: flex; align-items: center; gap: 24px; font-size: 15px; font-weight: 500; }
  .nav-link { color: var(--on-slate-muted); }
  .nav-link:hover { color: var(--on-slate); }
  .nav-pill {
    padding: 10px 18px;
    border: 1px solid var(--slate-line);
    border-radius: 999px;
    font-weight: 600;
  }
  .nav-pill:hover { border-color: var(--on-slate-faint); }
  @media (max-width: 599px) { .hide-sm { display: none; } }

  .hero-main {
    position: relative;
    display: grid;
    gap: 40px;
    padding: 20px 0 40px;
  }
  @media (min-width: 1180px) {
    .hero-main {
      grid-template-columns: minmax(0, 580px) minmax(0, 1fr);
      gap: 64px;
      align-items: center;
      min-height: 700px;
      padding: 24px 0 72px;
    }
  }

  .hero-copy { display: flex; flex-direction: column; gap: 22px; }
  @media (min-width: 1180px) { .hero-copy { gap: 28px; } }

  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.032em;
    color: #fff;
    text-wrap: balance;
  }
  .accent {
    background: linear-gradient(90deg, #15d15a, #c6f000);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--on-slate-muted);
    max-width: 520px;
  }

  /* The two doors. Business is the brightest thing on the page; courier is
     visible but quiet. Stacked with the arrow on the right on a phone,
     side by side as tall cards from 640px. */
  .doors { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }
  .door-col { display: flex; flex-direction: column; gap: 10px; }

  .door {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    border-radius: 18px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .door:hover { transform: translateY(-2px); }
  .door:focus-visible { outline: 3px solid #c6f000; outline-offset: 3px; }
  .door-text { display: flex; flex-direction: column; gap: 4px; }
  .door-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .door-title { font-family: var(--display); font-size: 22px; font-weight: 700; line-height: 1.1; }
  .door-sub { font-size: 13px; font-weight: 500; }
  .door-arrow { font-size: 26px; font-weight: 700; line-height: 1; }

  .door-business { background: var(--neon); color: var(--ink-on-neon); }
  .door-business:hover { box-shadow: 0 12px 32px rgba(31, 196, 110, 0.35); }
  .door-business .door-kicker,
  .door-business .door-sub { opacity: 0.78; }

  .door-courier { background: var(--slate-2); border: 1px solid var(--slate-line); color: var(--on-slate); }
  .door-courier:hover { background: #2c3c44; }
  .door-courier .door-kicker { color: var(--on-slate-faint); }
  .door-courier .door-sub { color: var(--on-slate-muted); }

  .wa-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid var(--slate-line);
    color: var(--on-slate);
    font-size: 15px;
    font-weight: 600;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .wa-btn svg { flex-shrink: 0; }
  .wa-btn:hover { border-color: #25d366; background: rgba(37, 211, 102, 0.06); }
  .wa-btn:focus-visible { outline: 3px solid #c6f000; outline-offset: 3px; }

  @media (min-width: 640px) {
    .doors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 8px; }
    .door {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 12px;
      min-height: 170px;
      padding: 22px;
      border-radius: 20px;
    }
    .door-text { gap: 12px; }
    .door-title { font-size: 24px; }
    .door-sub { font-size: 14px; }
    .door-arrow { display: none; }
    .door-title::after { content: ' →'; }
    .door-courier { align-self: start; }
  }

  /* ---------- Product visual ---------- */
  .visual { position: relative; height: 330px; width: 100%; max-width: 480px; }
  @media (min-width: 640px) { .visual { margin-inline: auto; } }
  @media (min-width: 1180px) { .visual { height: 560px; max-width: none; margin-inline: 0; } }

  .panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 290px;
    height: 250px;
    border-radius: 16px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
    display: flex;
    overflow: hidden;
  }
  .panel-rail { display: none; }
  .panel-body { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 12px; }
  .panel-head { display: flex; align-items: center; justify-content: space-between; }
  .panel-title { font-family: var(--display); font-weight: 700; font-size: 15px; }
  .live { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: #15803d; }
  .live i { width: 6px; height: 6px; border-radius: 50%; background: #16a34a; }
  .panel-split { flex: 1; display: flex; gap: 12px; min-height: 0; }
  .orders { display: none; }
  .map { flex: 1; border-radius: 10px; background: #eaf0ec; overflow: hidden; }
  .map svg, .phone-map svg { width: 100%; height: 100%; display: block; max-width: none; }

  .phone {
    position: absolute;
    right: 0;
    top: 70px;
    width: 170px;
    height: 260px;
    border-radius: 28px;
    background: #0e1417;
    padding: 6px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 22px;
    background: var(--card);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .phone-map { display: none; background: #eaf0ec; }
  .offer { flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 12px; }
  .offer-head { display: flex; align-items: center; justify-content: space-between; }
  .offer-kicker { font-size: 10px; font-weight: 700; color: var(--emerald-700); text-transform: uppercase; letter-spacing: 0.06em; }
  .offer-route { font-family: var(--display); font-size: 17px; font-weight: 700; line-height: 1.1; margin-top: 6px; }
  .offer-meta { font-size: 11px; color: var(--ink-faint); }
  .offer-actions { margin-top: auto; display: flex; flex-direction: column-reverse; gap: 2px; }
  .btn-accept {
    text-align: center;
    padding: 10px 0;
    border-radius: 10px;
    background: var(--emerald-700);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }
  .btn-ghost { text-align: center; padding: 8px 0; font-size: 11px; font-weight: 600; color: var(--ink-faint); }

  .chip { font-style: normal; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 999px; align-self: flex-start; }
  .chip-green { color: var(--emerald-700); background: #ddefe6; }
  .chip-amber { color: #92400e; background: #fdf1d6; }

  @media (min-width: 1180px) {
    .panel { top: 40px; width: 92%; height: 380px; border-radius: 18px; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35); }
    .panel-rail {
      width: 64px;
      background: #f3f2ee;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      padding-top: 18px;
    }
    .rail-dot { width: 28px; height: 28px; border-radius: 8px; background: #e7e6e1; }
    .rail-dot.on { background: #ddefe6; }
    .panel-body { padding: 16px; gap: 12px; }
    .panel-title { font-size: 17px; }
    .live { font-size: 12px; }
    .live i { width: 7px; height: 7px; }
    .orders { width: 170px; display: flex; flex-direction: column; gap: 8px; }
    .order {
      padding: 10px;
      border-radius: 10px;
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 11px;
      color: var(--ink-faint);
    }
    .order b { font-size: 12px; color: var(--ink); }
    .chip { font-size: 11px; padding: 2px 8px; }
    .map { border-radius: 12px; }

    .phone { right: -8px; top: 170px; width: 230px; height: 400px; border-radius: 34px; padding: 8px; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5); }
    .phone-screen { border-radius: 27px; }
    .phone-map { display: block; height: 170px; }
    .offer { padding: 14px; gap: 8px; }
    .offer-kicker { font-size: 12px; }
    .offer-route { font-size: 20px; margin-top: 0; }
    .offer-meta { font-size: 12px; }
    .offer .chip { font-size: 12px; }
    .offer-actions { flex-direction: row; gap: 8px; }
    .btn-ghost { flex: 1; padding: 11px 0; border-radius: 12px; border: 1px solid #e0dfda; font-size: 13px; }
    .btn-accept { flex: 2; padding: 11px 0; border-radius: 12px; font-size: 13px; }
  }

  /* ---------- Steps ---------- */
  .steps-section { padding: 48px 0 40px; }
  @media (min-width: 768px) { .steps-section { padding: 80px 0 72px; } }
  .steps-section h2,
  .closing h2 {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.022em;
    line-height: 1.1;
    text-wrap: balance;
  }
