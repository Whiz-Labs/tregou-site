---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

const pageTitle = 'Tregou — Suas entregas no automático';
const pageDescription = 'Pedidos dos apps de delivery, do WhatsApp ou do balcão vão sozinhos pros seus entregadores, na melhor rota. Entregador? Entre na Rede Tregou.';
const { whatsappLink, whatsappNumber, signupLink, privacyLink, orderApps } = config;

// "iFood" / "iFood e Anota AI" / "iFood, Anota AI e X"
const listPt = (names: readonly string[]) =>
  names.length <= 1 ? names.join('') : `${names.slice(0, -1).join(', ')} e ${names[names.length - 1]}`;
const liveApps = orderApps.filter((a) => a.live).map((a) => a.name);
const soonApps = orderApps.filter((a) => !a.live).map((a) => a.name);
const appsNow =
  `${listPt(liveApps)} hoje` + (soonApps.length ? `, ${listPt(soonApps)} chegando` : '') + ' e outros apps aos poucos';

const faqs = [
  {
    id: 'resolve',
    q: 'O que o Tregou resolve no dia a dia?',
    lead: 'Tira você do papel de despachante. Hoje é você quem decide quem leva cada pedido, junta entregas no grupo do WhatsApp, explica o caminho e responde "cadê meu pedido?".',
    points: [
      'cada pedido vai sozinho pro entregador certo, juntando os do mesmo caminho;',
      'o entregador recebe a rota pronta no app, com o prazo de cada entrega à vista;',
      'você acompanha todos no mapa, ao vivo.',
    ],
    tail: 'O melhor jeito de entender é ver com os seus pedidos.',
    cta: true,
  },
  {
    id: 'pedidos',
    q: 'Quais pedidos entram? Preciso ter iFood?',
    lead: `Não precisa. Você cria a conta e conecta seus apps de pedido depois, em Integrações: ${appsNow}. Pedidos do WhatsApp e do balcão você lança no painel em segundos.`,
  },
  {
    id: 'entregador',
    q: 'O que o entregador precisa?',
    lead: 'Um celular Android com o app do Tregou. A gente manda o link de instalação, e ele entra com o número de telefone.',
  },
  {
    id: 'cidade',
    q: 'Funciona na minha cidade?',
    lead: 'O Tregou funciona em qualquer cidade com os seus entregadores. A Rede Tregou, de entregadores parceiros, está começando em João Pessoa.',
  },
  {
    id: 'custo',
    q: 'Quanto custa?',
    lead: 'Todo negócio começa testando grátis, sem cartão. Depois, você escolhe o plano que cabe na sua operação.',
  },
  {
    // The seat is earned on the first delivery, not at signup (migrations
    // 051/084); after the 10 the trial is one week.
    id: 'fundadora',
    q: 'Como viro Fundadora?',
    lead: 'As 10 primeiras empresas que fizerem a primeira entrega pelo Tregou viram Fundadoras: 1 mês grátis, contado a partir dessa entrega, e preço travado pra sempre.',
    tail: 'Não basta se cadastrar: a vaga é de quem começa a usar. Depois das 10, o teste grátis é de 1 semana.',
  },
];

// A business that isn't ready to sign up gets a conversation, not a form:
// the message is typed for them, they only press send.
const waBusiness = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  'Oi! Tenho um negócio e quero saber se o Tregou serve pra mim.'
)}`;
// A business with no couriers of its own: the Rede is starting in João
// Pessoa and isn't open yet, so this is a waiting list, not a promise.
const waRede = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  'Oi! Tenho um negócio em João Pessoa e preciso de entregadores.'
)}`;

// The landing is a fork, not a brochure: a business goes to sign-up, a courier
// goes to the Rede pre-registration. Everything else on the page is there to
// make one of those two clicks easier.
const fonts =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap';
---

<BaseLayout title={pageTitle} description={pageDescription} fontsHref={fonts}>
  <section class="hero">
    <div class="wrap">
      <nav class="nav">
        <img src="/brand/tregou-wordmark.svg" alt="Tregou" class="nav-logo" width="116" height="30" />
        <div class="nav-actions">
          <a href={whatsappLink} class="nav-link hide-sm" data-ev="nav_whatsapp" target="_blank" rel="noopener">Fale conosco</a>
          <a href="https://panel.tregou.app" class="nav-pill" data-ev="nav_login" target="_blank" rel="noopener">Entrar</a>
        </div>
      </nav>

      <div class="hero-main">
        <div class="hero-copy">
          <h1>Suas entregas no <span class="accent">automático</span>.</h1>
          <p class="lede">Pedidos dos apps de delivery, do WhatsApp ou do balcão vão sozinhos pros seus entregadores, na melhor rota.</p>

          <div class="doors">
            <div class="door-col">
              <!-- data-ev stays "hero_signup" so the click rate compares with
                   the previous landing's hero button. -->
              <a href={`${signupLink}?src=hero`} class="door door-business" data-ev="hero_signup" target="_blank" rel="noopener">
                <span class="door-text">
                  <span class="door-top">
                    <span class="door-kicker">Tenho um negócio</span>
                    <span class="door-badge">10 primeiras · 1 mês grátis</span>
                  </span>
                  <span class="door-title">Criar conta grátis</span>
                  <span class="door-sub">Sem cartão · leva 2 minutos</span>
                </span>
                <span class="door-arrow" aria-hidden="true">→</span>
              </a>
              <a href={waBusiness} class="wa-btn" data-ev="hero_whatsapp" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="#25D366" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Tirar dúvidas no WhatsApp
              </a>
            </div>
            <a href="/entregador?src=home" class="door door-courier" data-ev="hero_courier">
              <span class="door-text">
                <span class="door-kicker">Sou entregador</span>
                <span class="door-title">Entrar na Rede Tregou</span>
                <span class="door-sub">30 segundos · sem documentos</span>
              </span>
              <span class="door-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Product visual: the panel's Operação view and the courier's offer.
             Drawn in markup, kept to what both screens really show. -->
        <div class="visual" aria-hidden="true">
          <div class="panel">
            <div class="panel-rail">
              <img src="/brand/tregou-icon-dark-neon.svg" alt="" width="30" height="30" />
              <span class="rail-dot on"></span>
              <span class="rail-dot"></span>
              <span class="rail-dot"></span>
            </div>
            <div class="panel-body">
              <div class="panel-head">
                <span class="panel-title">Operação</span>
                <span class="live"><i></i>Ao vivo</span>
              </div>
              <div class="panel-split">
                <div class="orders">
                  <div class="order">
                    <b>#4521 · Carlos</b>
                    <span>Pronto · Bessa</span>
                    <em class="chip chip-green">Oferta enviada</em>
                  </div>
                  <div class="order">
                    <b>#4520 · Ana</b>
                    <span>Em entrega · Manaíra</span>
                    <em class="chip chip-amber">12 min</em>
                  </div>
                  <div class="order">
                    <b>#4519 · João</b>
                    <span>Entregue</span>
                  </div>
                </div>
                <div class="map">
                  <svg viewBox="0 0 300 280" preserveAspectRatio="xMidYMid slice">
                    <path d="M0 70 H300 M0 170 H300 M0 240 H300 M60 0 V280 M150 0 V280 M235 0 V280" stroke="#fff" stroke-width="10" />
                    <path d="M60 240 C 60 170, 150 190, 150 120 S 235 70, 235 40" fill="none" stroke="#088A5F" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 10" />
                    <circle cx="60" cy="240" r="11" fill="#1F2A30" />
                    <circle cx="150" cy="120" r="9" fill="#fff" stroke="#088A5F" stroke-width="4" />
                    <circle cx="235" cy="40" r="9" fill="#fff" stroke="#088A5F" stroke-width="4" />
                    <circle cx="112" cy="170" r="10" fill="#2F6FEB" stroke="#fff" stroke-width="4" />
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <div class="phone">
            <div class="phone-screen">
              <div class="phone-map">
                <svg viewBox="0 0 214 170">
                  <path d="M0 50 H214 M0 120 H214 M70 0 V170 M150 0 V170" stroke="#fff" stroke-width="9" />
                  <path d="M70 150 C 70 100, 150 110, 150 50" fill="none" stroke="#088A5F" stroke-width="5" stroke-linecap="round" />
                  <circle cx="70" cy="150" r="9" fill="#2F6FEB" stroke="#fff" stroke-width="3" />
                  <circle cx="150" cy="50" r="8" fill="#fff" stroke="#088A5F" stroke-width="4" />
                </svg>
              </div>
              <div class="offer">
                <div class="offer-head">
                  <span class="offer-kicker">Nova entrega</span>
                  <span class="chip chip-amber">0:48</span>
                </div>
                <span class="offer-route">Bessa → Manaíra</span>
                <span class="offer-meta">2,4 km · 1 entrega</span>
                <div class="offer-actions">
                  <span class="btn-ghost">Recusar</span>
                  <span class="btn-accept">Aceitar</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="steps-section">
    <div class="wrap">
      <h2>Do pedido à porta, sem você no meio.</h2>
      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <span class="step-text"><b>O pedido entra</b>Do {listPt(liveApps)}, sozinho. WhatsApp e balcão, você lança em segundos.</span>
        </li>
        <li>
          <span class="step-n">2</span>
          <span class="step-text"><b>Vai pro entregador certo</b>Sozinho, juntando os pedidos do mesmo caminho.</span>
        </li>
        <li>
          <span class="step-n">3</span>
          <span class="step-text"><b>Chega na porta</b>Rota pronta no app dele. Você vê tudo no mapa.</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Answers the questions a business asks before it signs up. The first one
       is open: it is the problem every restaurant has, and it ends on the
       free trial. Native <details>, so it works without script; each question
       carries data-ev, so we learn which ones people actually open. -->
  <section class="faq-section">
    <div class="wrap faq-grid">
      <div class="faq-intro">
        <h2>Perguntas frequentes</h2>
        <p>Outra dúvida? <a href={waBusiness} data-ev="faq_whatsapp" target="_blank" rel="noopener">Fale no WhatsApp</a></p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary data-ev={`faq_${f.id}`}>
              <span>{f.q}</span>
              <i aria-hidden="true"></i>
            </summary>
            <div class="faq-a">
              <p>{f.lead}</p>
              {f.points && (
                <>
                  <p>Com o Tregou:</p>
                  <ul>{f.points.map((p) => <li>{p}</li>)}</ul>
                </>
              )}
              {f.tail && <p>{f.tail}</p>}
              {f.cta && (
                <a href={`${signupLink}?src=faq`} class="btn-primary" data-ev="faq_signup" target="_blank" rel="noopener">Testar grátis →</a>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- The last call: which business are you? One with couriers signs up;
       one without joins the Rede's waiting list. The quiz stays as one line
       for the business that would rather not talk to anyone yet. -->
  <section class="fork-section">
    <div class="wrap">
      <h2>Com ou sem entregadores, o Tregou serve pra você.</h2>
      <div class="fork">
        <div class="fork-card">
          <span class="fork-kicker">Já tenho entregadores</span>
          <b>Seus entregadores, organizados.</b>
          <p>Crie sua conta, cadastre sua equipe e os pedidos começam a chegar no app deles.</p>
          <a href={`${signupLink}?src=block`} class="btn-primary" data-ev="block_signup" target="_blank" rel="noopener">Criar conta grátis →</a>
        </div>
        <div class="fork-card">
          <span class="fork-head">
            <span class="fork-kicker">Preciso de entregadores</span>
            <span class="city">João Pessoa</span>
          </span>
          <b>A Rede Tregou está começando em João Pessoa.</b>
          <p>Entregadores parceiros perto de você. Entre na lista e a gente te avisa.</p>
          <a href={waRede} class="btn-secondary" data-ev="block_rede" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="#25D366" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Quero entregadores →
          </a>
        </div>
      </div>
      <p class="quiz-line">
        <span>Não sabe se serve pro seu negócio?</span>
        <a href="/comecar?src=home" data-ev="block_quiz">Faça o teste de 30s →</a>
      </p>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap footer-row">
      <img src="/brand/tregou-wordmark-light.svg" alt="Tregou" class="footer-logo" width="86" height="22" />
      <div class="footer-links">
        <a href="/entregador?src=footer" data-ev="footer_courier">Sou entregador</a>
        <a href={privacyLink} target="_blank" rel="noopener">Privacidade</a>
        <a href="https://instagram.com/tregou.app" target="_blank" rel="noopener">Instagram</a>
        <span>© {new Date().getFullYear()} Tregou</span>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* Two layers (brand rule): the hero is the energetic brand moment — slate
     ground, neon from the logo arrow; the rest is the calm work surface —
     warm neutral, emerald buttons. */
  :global(:root) {
    --slate: #1f2a30;
    --slate-2: #26343b;
    --slate-line: #3b4b52;
    --on-slate: #f4f7f5;
    --on-slate-muted: #b9c6c0;
    --on-slate-faint: #8fa39a;
    --neon: #1fc46e;
    --ink-on-neon: #0b1a12;
    --emerald-700: #07734f;
    --emerald-600: #088a5f;
    --ground: #f6f5f1;
    --card: #ffffff;
    --line: #e7e6e1;
    --ink: #1f2a30;
    --ink-muted: #4a5a54;
    --ink-faint: #5b6b64;
    --display: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
    --body: 'Figtree', system-ui, -apple-system, sans-serif;
  }

  :global(body) {
    font-family: var(--body);
    background: var(--ground);
    color: var(--ink);
  }

  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: none; }

  .wrap {
    width: 100%;
    max-width: 1248px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) { .wrap { padding-inline: 48px; } }

  /* ---------- Hero ---------- */
  .hero {
    background: var(--slate);
    color: var(--on-slate);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    right: -180px;
    top: -220px;
    width: 760px;
    height: 760px;
    border-radius: 50%;
    background: #243a33;
    opacity: 0.55;
    pointer-events: none;
  }

  .nav {
    position: relative;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  @media (min-width: 768px) { .nav { height: 88px; } }
  .nav-logo { height: 24px; width: auto; }
  @media (min-width: 768px) { .nav-logo { height: 30px; } }
  .nav-actions { display: flex; align-items: center; gap: 24px; font-size: 15px; font-weight: 500; }
  .nav-link { color: var(--on-slate-muted); }
  .nav-link:hover { color: var(--on-slate); }
  .nav-pill {
    padding: 10px 18px;
    border: 1px solid var(--slate-line);
    border-radius: 999px;
    font-weight: 600;
  }
  .nav-pill:hover { border-color: var(--on-slate-faint); }
  @media (max-width: 599px) { .hide-sm { display: none; } }

  .hero-main {
    position: relative;
    display: grid;
    gap: 40px;
    padding: 20px 0 40px;
  }
  @media (min-width: 1180px) {
    .hero-main {
      grid-template-columns: minmax(0, 580px) minmax(0, 1fr);
      gap: 64px;
      align-items: center;
      min-height: 700px;
      padding: 24px 0 72px;
    }
  }

  .hero-copy { display: flex; flex-direction: column; gap: 22px; }
  @media (min-width: 1180px) { .hero-copy { gap: 28px; } }

  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.75rem, 1.6rem + 4.6vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.032em;
    color: #fff;
    text-wrap: balance;
  }
  .accent {
    background: linear-gradient(90deg, #15d15a, #c6f000);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--on-slate-muted);
    max-width: 520px;
  }

  /* The two doors, stacked at every width so neither title ever wraps and
     the order reads as the hierarchy: business first and brightest, its
     WhatsApp right under it (same group, tight gap), then the courier door
     after a wider gap, quieter. */
  .doors { display: flex; flex-direction: column; gap: 24px; margin-top: 4px; max-width: 540px; }
  .door-col { display: flex; flex-direction: column; gap: 10px; }

  .door {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    border-radius: 18px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .door:hover { transform: translateY(-2px); }
  .door:focus-visible { outline: 3px solid #c6f000; outline-offset: 3px; }
  .door-text { flex-grow: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .door-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .door-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .door-badge {
    font-size: 12px;
    font-weight: 700;
    color: #fece00;
    background: var(--ink-on-neon);
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .door-title { font-family: var(--display); font-size: 22px; font-weight: 700; line-height: 1.1; }
  .door-sub { font-size: 13px; font-weight: 500; }
  .door-arrow { flex-shrink: 0; font-size: 26px; font-weight: 700; line-height: 1; }

  .door-business { background: var(--neon); color: var(--ink-on-neon); }
  .door-business:hover { box-shadow: 0 12px 32px rgba(31, 196, 110, 0.35); }
  .door-business .door-kicker,
  .door-business .door-sub { opacity: 0.78; }

  .door-courier { background: var(--slate-2); border: 1px solid var(--slate-line); color: var(--on-slate); }
  .door-courier:hover { background: #2c3c44; }
  .door-courier .door-kicker { color: var(--on-slate-faint); }
