---
// One layout for the pages that answer a search ("sistema de entregas para
// restaurantes", "gestão de motoboys"…). The landing stays short and only
// routes; these pages carry the words people search for and end on the same
// sign-up. Drawn on the site canvas (row "Páginas de busca"): dark top with a
// product visual, problem, three steps, a dark list band, who it is for, FAQ,
// closing. Each page passes its copy as data and its visual as the slot.
import BaseLayout from './BaseLayout.astro';
import { config } from '../config';
import { solutionPages } from '../solutions';
import '../styles/brand.css';

interface Item {
  title: string;
  text: string;
}

interface Props {
  /** Short key for the click log and ?src= ("rest" → rest_signup). */
  slug: string;
  title: string;
  description: string;
  kicker: string;
  h1: string;
  lede: string;
  problem: { title: string; paragraphs: string[] };
  steps: { title: string; items: Item[] };
  list: { title: string; items: Item[] };
  who: { title: string; text: string };
  faqs: { q: string; a: string }[];
  closing: string;
  /** WhatsApp message typed for the visitor. */
  waText: string;
}

const { slug, title, description, kicker, h1, lede, problem, steps, list, who, faqs, closing, waText } = Astro.props;
const { signupLink, whatsappNumber, privacyLink } = config;

const signup = `${signupLink}?src=${slug}`;
const wa = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waText)}`;
const here = new URL(Astro.url.pathname, Astro.site).toString();
const others = solutionPages.filter((p) => !Astro.url.pathname.startsWith(p.href));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Tregou', item: 'https://tregou.app/' },
      { '@type': 'ListItem', position: 2, name: kicker, item: here },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const fonts =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap';
---

<BaseLayout title={title} description={description} fontsHref={fonts} jsonLd={jsonLd}>
  <header class="top">
    <div class="wrap">
      <nav class="nav">
        <a href="/" aria-label="Tregou — início">
          <img src="/brand/tregou-wordmark.svg" alt="Tregou" class="nav-logo" width="116" height="30" />
        </a>
        <a href="https://panel.tregou.app" class="nav-pill" data-ev={`${slug}_login`} target="_blank" rel="noopener">Entrar</a>
      </nav>
      <div class="top-main">
        <div class="top-copy">
          <span class="kicker">{kicker}</span>
          <h1>{h1}</h1>
          <p class="lede">{lede}</p>
          <div class="top-actions">
            <a href={signup} class="btn-neon" data-ev={`${slug}_signup`} target="_blank" rel="noopener">Criar conta grátis →</a>
            <a href={wa} class="btn-ghost" data-ev={`${slug}_whatsapp`} target="_blank" rel="noopener">Tirar dúvidas no WhatsApp</a>
          </div>
          <span class="fine">Sem cartão · leva 2 minutos</span>
        </div>
        <div class="visual" aria-hidden="true">
          <slot name="visual" />
        </div>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="block narrow">
      <h2>{problem.title}</h2>
      {problem.paragraphs.map((p) => <p class="body-text">{p}</p>)}
    </section>

    <section class="block">
      <h2>{steps.title}</h2>
      <ol class="steps">
        {steps.items.map((s, i) => (
          <li>
            <span class="step-n">{i + 1}</span>
            <span class="step-text"><b>{s.title}</b>{s.text}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="band">
      <h2>{list.title}</h2>
      <ul class="band-list">
        {list.items.map((it) => (
          <li>
            <span class="check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
            </span>
            <span class="band-text"><b>{it.title}</b>{it.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block narrow">
      <h2>{who.title}</h2>
      <p class="body-text">{who.text}</p>
      <p class="related">
        Veja também:{' '}
        {others.map((p, i) => (
          <>
            {i > 0 && ' · '}
            <a href={p.href}>{p.label}</a>
          </>
        ))}
      </p>
    </section>

    <section class="block faq">
      <h2>Perguntas frequentes</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <i aria-hidden="true"></i>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="closing">
      <h2>{closing}</h2>
      <div class="closing-actions">
        <a href={signup} class="btn-primary" data-ev={`${slug}_end_signup`} target="_blank" rel="noopener">Testar grátis →</a>
        <a href={wa} class="btn-secondary" data-ev={`${slug}_end_whatsapp`} target="_blank" rel="noopener">Falar no WhatsApp</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-row">
      <a href="/"><img src="/brand/tregou-wordmark-light.svg" alt="Tregou" class="footer-logo" width="86" height="22" /></a>
      <div class="footer-links">
        <a href="/blog/">Blog</a>
        {others.map((p) => <a href={p.href}>{p.label}</a>)}
        <a href="/entregador" data-ev={`${slug}_courier`}>Sou entregador</a>
        <a href={privacyLink} target="_blank" rel="noopener">Privacidade</a>
        <span>© {new Date().getFullYear()} Tregou</span>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(body) {
    font-family: var(--body);
    background: var(--ground);
    color: var(--ink);
  }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: none; }

  .wrap {
    width: 100%;
    max-width: 1248px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) { .wrap { padding-inline: 48px; } }

  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.45rem + 1vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }

  /* ---------- Dark top: the brand moment ---------- */
  .top { background: var(--slate); color: var(--on-slate); }
  .nav { height: 64px; display: flex; align-items: center; justify-content: space-between; }
  @media (min-width: 768px) { .nav { height: 88px; } }
  .nav-logo { height: 24px; width: auto; }
  @media (min-width: 768px) { .nav-logo { height: 30px; } }
  .nav-pill { padding: 10px 18px; border: 1px solid var(--slate-line); border-radius: 999px; font-size: 15px; font-weight: 600; }
  .nav-pill:hover { border-color: var(--on-slate-faint); }

  .top-main { display: grid; gap: 36px; padding: 16px 0 44px; }
  @media (min-width: 1100px) {
    .top-main { grid-template-columns: minmax(0, 640px) minmax(0, 1fr); gap: 72px; align-items: center; padding: 32px 0 88px; }
  }
  .top-copy { display: flex; flex-direction: column; gap: 18px; }
  @media (min-width: 768px) { .top-copy { gap: 24px; } }
  .kicker { font-size: 13px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--neon); }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.5rem, 1.7rem + 2.6vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.033em;
    color: #fff;
    text-wrap: balance;
  }
  .lede { font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.5; color: var(--on-slate-muted); }
  .top-actions { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }
  @media (min-width: 600px) { .top-actions { flex-direction: row; } }
  .fine { font-size: 14px; color: var(--on-slate-faint); }
  .visual { display: flex; flex-direction: column; }

  .btn-neon,
  .btn-ghost {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 24px;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
  }
  .btn-neon { background: var(--neon); color: var(--ink-on-neon); }
  .btn-neon:hover { background: #2bd67c; }
  .btn-ghost { border: 1px solid var(--slate-line); color: var(--on-slate); font-weight: 600; }
  .btn-ghost:hover { border-color: var(--on-slate-faint); }

  .btn-primary,
  .btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 14px 22px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
  }
  .btn-primary { background: var(--emerald-700); color: #fff; }
  .btn-primary:hover { background: #065f41; }
  .btn-secondary { border: 1px solid #d5d4ce; color: var(--ink); }
  .btn-secondary:hover { border-color: var(--ink-faint); }
  .btn-neon:focus-visible,
  .btn-ghost:focus-visible,
  .btn-primary:focus-visible,
  .btn-secondary:focus-visible { outline: 3px solid var(--emerald-600); outline-offset: 3px; }

  /* ---------- Calm body ---------- */
  .block { padding-top: 48px; display: flex; flex-direction: column; gap: 18px; }
  @media (min-width: 768px) { .block { padding-top: 88px; } }
  .narrow { max-width: 760px; }
  .body-text { font-size: 17px; line-height: 1.65; color: var(--ink-muted); }
  @media (min-width: 768px) { .body-text { font-size: 18px; } }
  .related { font-size: 15px; color: var(--ink-muted); }
  .related a,
  .faq-list a { color: var(--emerald-700); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .steps { list-style: none; display: grid; gap: 26px; margin-top: 8px; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 22px; } }
  .steps li { display: flex; gap: 18px; align-items: flex-start; }
  .step-n {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--slate);
    color: var(--neon);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-weight: 800;
    font-size: 20px;
  }
  .step-text { display: flex; flex-direction: column; gap: 6px; font-size: 16px; line-height: 1.55; color: var(--ink-muted); }
  .step-text b { font-size: 19px; color: var(--ink); }

  .band {
    margin-top: 48px;
    padding: 28px 22px 16px;
    border-radius: 24px;
    background: var(--slate);
    display: grid;
    gap: 8px;
  }
  @media (min-width: 900px) {
    .band { margin-top: 88px; padding: 48px 56px; border-radius: 28px; grid-template-columns: 340px minmax(0, 1fr); gap: 64px; align-items: start; }
  }
  .band h2 { color: #fff; }
  .band-list { list-style: none; }
  @media (min-width: 900px) { .band-list { border-top: 1px solid var(--slate-line); } }
  .band-list li { display: flex; gap: 14px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--slate-line); }
  @media (min-width: 900px) { .band-list li { padding: 20px 0; } }
  .band-list li:last-child { border-bottom: 0; }
  @media (min-width: 900px) { .band-list li:last-child { border-bottom: 1px solid var(--slate-line); } }
  .check {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--slate-2);
    color: var(--neon);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .band-text { display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.5; color: var(--on-slate-muted); }
  .band-text b { font-size: 17px; color: #fff; }

  .faq { gap: 14px; }
  @media (min-width: 900px) { .faq { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 64px; align-items: start; } }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 18px 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
  }
  @media (min-width: 768px) { .faq-list summary { font-size: 19px; } }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary:focus-visible { outline: 3px solid var(--emerald-600); outline-offset: 2px; border-radius: 6px; }
  .faq-list summary i { flex-shrink: 0; position: relative; width: 32px; height: 32px; border-radius: 50%; background: #edece6; }
  .faq-list summary i::before,
  .faq-list summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: var(--emerald-700);
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }
  .faq-list summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-list details[open] summary i::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-list details p { padding: 0 0 22px; font-size: 16px; line-height: 1.6; color: var(--ink-muted); max-width: 640px; }

  .closing {
    margin: 48px 0;
    padding: 28px 22px;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .closing-actions { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }
  @media (min-width: 900px) {
    .closing { margin: 88px 0; padding: 48px 56px; flex-direction: row; align-items: center; justify-content: space-between; }
    .closing h2 { max-width: 620px; }
    .closing-actions { flex-direction: row; }
  }

  .footer { padding: 28px 0 36px; font-size: 14px; color: var(--ink-faint); border-top: 1px solid var(--line); }
  .footer-row { display: flex; flex-direction: column; gap: 14px; }
  .footer-logo { height: 20px; width: auto; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 10px 24px; }
  .footer-links a:hover { color: var(--ink); }
  @media (min-width: 768px) {
    .footer { padding: 36px 0; }
    .footer-row { flex-direction: row; align-items: center; justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-list summary i::before, .faq-list summary i::after { transition: none; }
  }
</style>
