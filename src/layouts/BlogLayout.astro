---
// Frame for the blog (list and post), drawn on the site canvas (row "Blog"):
// dark top with the Blog crumb beside the logo, calm body, shared footer.
// The page fills the dark top through the "top" slot and the body as usual.
import BaseLayout from './BaseLayout.astro';
import { config } from '../config';
import { solutionPages } from '../solutions';
import '../styles/brand.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, ogImage, jsonLd } = Astro.props;
const { privacyLink } = config;

const fonts =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap';
---

<BaseLayout title={title} description={description} ogImage={ogImage} fontsHref={fonts} jsonLd={jsonLd}>
  <header class="top">
    <div class="wrap">
      <nav class="nav">
        <div class="brand">
          <a href="/" aria-label="Tregou — início">
            <img src="/brand/tregou-wordmark.svg" alt="Tregou" class="nav-logo" width="116" height="30" />
          </a>
          <a href="/blog/" class="crumb">Blog</a>
        </div>
        <a href="https://panel.tregou.app" class="nav-pill" data-ev="blog_login" target="_blank" rel="noopener">Entrar</a>
      </nav>
      <slot name="top" />
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer-row">
      <a href="/"><img src="/brand/tregou-wordmark-light.svg" alt="Tregou" class="footer-logo" width="86" height="22" /></a>
      <div class="footer-links">
        <a href="/blog/">Blog</a>
        {solutionPages.map((p) => <a href={p.href}>{p.label}</a>)}
        <a href="/entregador" data-ev="blog_courier">Sou entregador</a>
        <a href={privacyLink} target="_blank" rel="noopener">Privacidade</a>
        <span>© {new Date().getFullYear()} Tregou</span>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(body) {
    font-family: var(--body);
    background: var(--ground);
    color: var(--ink);
  }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: none; }

  .wrap {
    width: 100%;
    max-width: 1248px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) { .wrap { padding-inline: 48px; } }

  .top { background: var(--slate); color: var(--on-slate); }
  .nav { height: 64px; display: flex; align-items: center; justify-content: space-between; }
  @media (min-width: 768px) { .nav { height: 88px; } }
  .brand { display: flex; align-items: center; gap: 12px; }
  @media (min-width: 768px) { .brand { gap: 20px; } }
  .nav-logo { height: 24px; width: auto; }
  @media (min-width: 768px) { .nav-logo { height: 30px; } }
  .crumb { font-size: 15px; font-weight: 600; color: var(--on-slate-muted); padding-left: 12px; border-left: 1px solid var(--slate-line); }
  @media (min-width: 768px) { .crumb { padding-left: 20px; } }
  .crumb:hover { color: var(--on-slate); }
  .nav-pill { padding: 10px 18px; border: 1px solid var(--slate-line); border-radius: 999px; font-size: 15px; font-weight: 600; }
  .nav-pill:hover { border-color: var(--on-slate-faint); }

  .footer { padding: 28px 0 36px; font-size: 14px; color: var(--ink-faint); border-top: 1px solid var(--line); }
  .footer-row { display: flex; flex-direction: column; gap: 14px; }
  .footer-logo { height: 20px; width: auto; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 10px 24px; }
  .footer-links a:hover { color: var(--ink); }
  @media (min-width: 768px) {
    .footer { padding: 36px 0; }
    .footer-row { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
