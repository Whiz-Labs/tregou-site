---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = '/og-image.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Anonymous traffic + CTA click log (see supabase/migrations/045_site_events.sql).
// Same public anon key as the quiz: RLS allows insert-only. Unset env → no-op.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon-64.png" sizes="64x64" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Styles -->
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    </style>
  </head>
  <body>
    <slot />

    <!--
      Cookieless analytics. Logs one pageview per load and every click on an
      element carrying data-ev="<cta-id>", so we can see which CTA people
      actually use — the signup form stores the matching ?src=, which closes
      the funnel on the panel side. The session id is a random per-tab value in
      sessionStorage (not a cookie, not persisted), and no IP is stored, so this
      needs no consent banner. Fire-and-forget: never blocks a navigation.
    -->
    <script is:inline define:vars={{ sbUrl: SUPABASE_URL, sbKey: SUPABASE_ANON_KEY }}>
      (function () {
        if (!sbUrl || !sbKey) return;

        var endpoint = sbUrl.replace(/\/$/, '') + '/rest/v1/site_events';
        var sid = null;
        try {
          sid = sessionStorage.getItem('tg_sid');
          if (!sid) {
            sid = Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
            sessionStorage.setItem('tg_sid', sid);
          }
        } catch (e) { /* private mode — the event still counts, just unlinked */ }

        // Campaign context, if the visit carried any.
        var utm = null;
        try {
          var qs = new URLSearchParams(location.search);
          ['src', 'utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) {
            var v = qs.get(k);
            if (v) {
              utm = utm || {};
              utm[k.replace('utm_', '')] = v.slice(0, 64);
            }
          });
        } catch (e) { /* ignore */ }

        function track(event, name) {
          try {
            return fetch(endpoint, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                apikey: sbKey,
                Authorization: 'Bearer ' + sbKey,
                Prefer: 'return=minimal',
              },
              body: JSON.stringify({
                event: event,
                name: name ? String(name).slice(0, 48) : null,
                path: location.pathname.slice(0, 200),
                session_id: sid,
                referrer: document.referrer ? document.referrer.slice(0, 500) : null,
                user_agent: (navigator.userAgent || '').slice(0, 400),
                utm: utm,
              }),
              // Survives the navigation the click is about to trigger.
              keepalive: true,
            }).catch(function () {});
          } catch (e) { return Promise.resolve(); }
        }

        track('pageview');

        // Capture phase so a handler that stops propagation can't hide the click.
        document.addEventListener(
          'click',
          function (e) {
            var el = e.target && e.target.closest ? e.target.closest('[data-ev]') : null;
            if (el) track('cta_click', el.getAttribute('data-ev'));
          },
          true
        );

        // Let page scripts log their own milestones (e.g. the quiz result).
        window.__tgTrack = track;
      })();
    </script>
  </body>
</html>

<style is:global>
  /* CSS Reset */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --font-family: 'Inter', system-ui, -apple-system, sans-serif;
    --color-text: #1a1a1a;
    --color-text-muted: #6b7280;
    --color-background: #ffffff;
    --color-primary: #2563eb;
    --color-primary-hover: #1d4ed8;
    --max-width: 1200px;
    --spacing-unit: 1rem;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-family);
    color: var(--color-text);
    background-color: var(--color-background);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img,
  picture,
  video,
  canvas,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--spacing-unit);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
