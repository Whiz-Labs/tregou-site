---
// The panel's Operação view, drawn in markup: orders on the left, the map
// with the courier and the route on the right. Kept to what the screen shows.
const orders = [
  { title: '#4521 · Carlos', sub: 'Pronto · Bessa', chip: 'Oferta enviada', tone: 'green' },
  { title: '#4520 · Ana', sub: 'Em entrega · Manaíra', chip: '12 min', tone: 'amber' },
  { title: '#4519 · João', sub: 'Entregue' },
];
---

<div class="panel">
  <div class="rail">
    <img src="/brand/tregou-icon-dark-neon.svg" alt="" width="28" height="28" />
    <span class="dot on"></span>
    <span class="dot"></span>
  </div>
  <div class="body">
    <div class="head">
      <span class="title">Operação</span>
      <span class="live"><i></i>Ao vivo</span>
    </div>
    <div class="split">
      <div class="orders">
        {orders.map((o) => (
          <div class="order">
            <b>{o.title}</b>
            <span>{o.sub}</span>
            {o.chip && <em class={`chip ${o.tone}`}>{o.chip}</em>}
          </div>
        ))}
      </div>
      <div class="map">
        <svg viewBox="0 0 300 280" preserveAspectRatio="xMidYMid slice">
          <path d="M0 70 H300 M0 170 H300 M0 240 H300 M60 0 V280 M150 0 V280 M235 0 V280" stroke="#fff" stroke-width="10" />
          <path d="M60 240 C 60 170, 150 190, 150 120 S 235 70, 235 40" fill="none" stroke="#088A5F" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 10" />
          <circle cx="60" cy="240" r="11" fill="#1F2A30" />
          <circle cx="150" cy="120" r="9" fill="#fff" stroke="#088A5F" stroke-width="4" />
          <circle cx="235" cy="40" r="9" fill="#fff" stroke="#088A5F" stroke-width="4" />
          <circle cx="112" cy="170" r="10" fill="#2F6FEB" stroke="#fff" stroke-width="4" />
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .panel {
    height: 340px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35);
    display: flex;
    overflow: hidden;
    color: var(--ink);
  }
  .rail { width: 56px; flex-shrink: 0; background: #f3f2ee; display: flex; flex-direction: column; align-items: center; gap: 16px; padding-top: 16px; }
  .dot { width: 26px; height: 26px; border-radius: 8px; background: #e7e6e1; }
  .dot.on { background: #ddefe6; }
  .body { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; padding: 16px; gap: 12px; }
  .head { display: flex; align-items: center; justify-content: space-between; }
  .title { font-family: var(--display); font-weight: 700; font-size: 17px; }
  .live { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: #15803d; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; }
  .split { flex-grow: 1; display: flex; gap: 12px; min-height: 0; }
  .orders { width: 160px; flex-shrink: 0; display: flex; flex-direction: column; gap: 8px; }
  .order { padding: 10px; border-radius: 10px; border: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .order b { font-size: 12px; }
  .order span { font-size: 11px; color: var(--ink-faint); }
  .chip { align-self: flex-start; font-style: normal; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
  .chip.green { color: #07734f; background: #ddefe6; }
  .chip.amber { color: #92400e; background: #fdf1d6; }
  .map { flex-grow: 1; border-radius: 12px; background: #eaf0ec; overflow: hidden; }
  .map svg { width: 100%; height: 100%; display: block; }
  @media (max-width: 420px) { .orders { width: 136px; } }
</style>
